function clampNumber(value, min, max, fallback) {
  const n = Number(value);
  if (!Number.isFinite(n)) return fallback;
  return Math.min(max, Math.max(min, n));
}

function getDiagramType(chapterTitle="", conceptTitle="") {
  const text = `${chapterTitle} ${conceptTitle}`.toLowerCase();

  if (
    /গতি|দূরত্ব|সরণ|বেগ|দ্রুতি|ত্বরণ|motion|velocity|speed|acceleration|distance|displacement/.test(text)
  ) return "motion";

  if (
    /তরঙ্গ|কম্পন|শব্দ|wave|vibration|sound|frequency|wavelength|amplitude/.test(text)
  ) return "wave";

  if (
    /বিদ্যুৎ|তড়িৎ|তড়িৎ|current|voltage|resistance|circuit|ওহম|ohm|series|parallel/.test(text)
  ) return "circuit";

  if (
    /বল|force|নিউটন|newton|ভর|mass|momentum|ঘর্ষণ|friction|weight/.test(text)
  ) return "force";

  if (
    /লেন্স|lens|দর্পণ|mirror|ফোকাস|focus|focal|আয়না|আয়না|প্রতিচ্ছবি|image formation/.test(text)
  ) {
    if (/লেন্স|lens/.test(text)) return "lens";
    return "mirror";
  }

  if (
    /কাজ|শক্তি|ক্ষমতা|work|energy|power|kinetic|potential|গতিশক্তি|বিভব/.test(text)
  ) return "energy";

  if (
    /তাপ|তাপমাত্রা|thermal|temperature|heat|calor|উষ্ণতা/.test(text)
  ) return "heat";

  if (
    /পরমাণু|atom|electron|proton|neutron|nucleus|ইলেকট্রন|প্রোটন|নিউট্রন/.test(text)
  ) return "atom";

  if (
    /চুম্বক|magnet|magnetic|field|চৌম্বক|electromagnet/.test(text)
  ) return "magnet";

  return "generic";
}

function DiagramBoard({chapter,state,update}) {
  const detectedType = getDiagramType(chapter?.title || "", chapter?.focus || "");

  const saved = state.diagrams?.[chapter.id] || {
    type: detectedType,
    label: chapter?.title || "Physics",
    value1: "5",
    value2: "10",
    unit1: "m",
    unit2: "s",
    angle: "30"
  };

  const values = {
    ...saved,
    type: saved.type || detectedType,
    label: saved.label || chapter?.title || "Physics",
    value1: saved.value1 ?? "5",
    value2: saved.value2 ?? "10",
    unit1: saved.unit1 ?? "m",
    unit2: saved.unit2 ?? "s",
    angle: saved.angle ?? "30"
  };

  const setValue = (key, value) => {
    const next = {
      ...values,
      [key]: value
    };

    update({
      diagrams: {
        ...state.diagrams,
        [chapter.id]: next
      }
    });
  };

  const resetDiagram = () => {
    update({
      diagrams: {
        ...state.diagrams,
        [chapter.id]: {
          type: detectedType,
          label: chapter?.title || "Physics",
          value1: "5",
          value2: "10",
          unit1: "m",
          unit2: "s",
          angle: "30"
        }
      }
    });
  };

  return (
    <section className="diagram-page">
      <div className="panel diagram-heading">
        <div>
          <span className="kicker">LIVE EDITABLE DIAGRAM</span>
          <h2>{chapter?.title || "Physics Diagram"}</h2>
          <p>
            নিচের মানগুলো পরিবর্তন করলেই diagram সঙ্গে সঙ্গে update হবে।
          </p>
        </div>

        <span className="badge">
          {values.type}
        </span>
      </div>

      <div className="diagram-layout">
        <div className="diagram-controls panel">

          <div className="diagram-field">
            <label>Diagram Type</label>
            <select
              value={values.type}
              onChange={(e) => setValue("type", e.target.value)}
            >
              <option value="generic">Generic Physics</option>
              <option value="motion">Motion</option>
              <option value="wave">Wave</option>
              <option value="circuit">Circuit</option>
              <option value="force">Force</option>
              <option value="lens">Lens</option>
              <option value="mirror">Mirror</option>
              <option value="energy">Energy</option>
              <option value="heat">Heat</option>
              <option value="atom">Atom</option>
              <option value="magnet">Magnet</option>
            </select>
          </div>

          <div className="diagram-field">
            <label>Label</label>
            <input
              type="text"
              value={values.label}
              onChange={(e) => setValue("label", e.target.value)}
              placeholder="Physics diagram"
            />
          </div>

          <div className="diagram-field">
            <label>Value 1</label>
            <input
              type="number"
              step="0.1"
              value={values.value1}
              onChange={(e) => setValue("value1", e.target.value)}
            />
          </div>

          <div className="diagram-field">
            <label>Value 2</label>
            <input
              type="number"
              step="0.1"
              value={values.value2}
              onChange={(e) => setValue("value2", e.target.value)}
            />
          </div>

          <div className="diagram-field">
            <label>Unit 1</label>
            <input
              type="text"
              value={values.unit1}
              onChange={(e) => setValue("unit1", e.target.value)}
            />
          </div>

          <div className="diagram-field">
            <label>Unit 2</label>
            <input
              type="text"
              value={values.unit2}
              onChange={(e) => setValue("unit2", e.target.value)}
            />
          </div>

          <div className="diagram-field">
            <label>Angle</label>
