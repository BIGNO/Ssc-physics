          <g>
            <path
              d="M370 115 Q410 255 370 395"
              className="optical-element"
            />
            <path
              d="M390 115 Q350 255 390 395"
              className="optical-element"
            />
            <text x="353" y="105" className="component-label">LENS</text>
          </g>
        ) : (
          <g>
            <path d="M500 105 Q455 255 500 405" className="optical-element"/>
            <line x1="507" y1="105" x2="507" y2="405" className="mirror-back"/>
            <text x="445" y="95" className="component-label">MIRROR</text>
          </g>
        )}

        <line
          x1={objectX}
          y1="255"
          x2={objectX}
          y2="145"
          className="object-ray"
        />

        <line
          x1={objectX-18}
          y1="145"
          x2={objectX+18}
          y2="145"
          className="object-cap"
        />

        <text x={objectX-25} y="132" className="object-label">OBJECT</text>

        <line
          x1={objectX}
          y1="145"
          x2={imageX}
          y2={255-imageHeight}
          className="light-ray"
          filter={`url(#${glowId})`}
        />

        <line
          x1={objectX}
          y1="255"
          x2={imageX}
          y2={255-imageHeight}
          className="light-ray"
          filter={`url(#${glowId})`}
