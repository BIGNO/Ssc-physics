              from={`0 380 245`}
              to={`360 380 245`}
              dur={`${3+i*.18}s`}
              repeatCount="indefinite"
            />
          </circle>
        ))}

        <text x="112" y="345" className="measurement">
          1st shell → max 2e⁻
        </text>

        <text x="112" y="375" className="measurement">
          Electrons shown = {electrons}
        </text>
      </LabFrame>
    );
  }

  if (type === "magnet") {
    const strength = Math.max(1, Math.min(12, Math.round(v1)));

    return (
      <LabFrame
        title="Magnetic Field"
        subtitle={`field strength = ${strength}`}
      >
        <rect
          x="310"
          y="205"
          width="85"
          height="72"
          rx="10"
          className="magnet-n"
        />

        <rect
          x="395"
          y="205"
          width="85"
          height="72"
          rx="10"
          className="magnet-s"
        />

        <text x="344" y="248" className="magnet-letter">N</text>
        <text x="427" y="248" className="magnet-letter">S</text>

        {Array.from({length:5}).map((_,i)=>(
          <path
            key={`top-${i}`}
            d={`M${310-i*28} 205 Q395 ${80-i*8} ${480+i*28} 205`}
            className="field-line"
            style={{animationDelay:`${i*0.16}s`}}
          />
        ))}

        {Array.from({length:5}).map((_,i)=>(
          <path
            key={`bottom-${i}`}
            d={`M${310-i*28} 277 Q395 ${405+i*8} ${480+i*28} 277`}
            className="field-line"
            style={{animationDelay:`${i*0.16}s`}}
          />
        ))}

        <text x="242" y="360" className="value-accent">
          Stronger field → denser lines
        </text>
      </LabFrame>
    );
  }

  return (
    <LabFrame
      title={values?.label || "Physics Experiment"}
      subtitle={`Value 1 = ${values?.value1 || 5} ${values?.unit1 || ""} • Value 2 = ${values?.value2 || 10} ${values?.unit2 || ""}`}
    >
      <line x1="100" y1="325" x2="660" y2="325" className="surface-line"/>

      <rect
        x="270"
        y="190"
        width={Math.min(190,80+v1*8)}
        height="100"
        rx="18"
        className="generic-object"
      />

      <line
        x1="180"
        y1="240"
        x2={180+Math.min(220,45+v2*11)}
        y2="240"
        className="vector-primary"
        markerEnd={`url(#${markerId})`}
        filter={`url(#${glowId})`}
      />

      <circle cx="350" cy="240" r="12" className="sensor-dot">
        <animate
          attributeName="r"
          values="10;15;10"
          dur="1.4s"
          repeatCount="indefinite"
        />
      </circle>

      <text x="290" y="245" className="block-text">
        Experiment
      </text>
    </LabFrame>
  );
}


function Learn({chapter}) {
