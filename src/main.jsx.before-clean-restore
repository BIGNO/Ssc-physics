function Practice({chapter,chapters,allQuestions}){
 const [scope,setScope]=useState('all');
 const [type,setType]=useState('all');
 const [year,setYear]=useState('all');
 const [importance,setImportance]=useState('all');
 const [query,setQuery]=useState('');
 const [bookmarks,setBookmarks]=useState(()=>{
   try{return JSON.parse(localStorage.getItem('physics-bookmarks')||'[]')}
   catch{return []}
 });
 const [showBookmarks,setShowBookmarks]=useState(false);

 const toggleBookmark=(id)=>{
   const next=bookmarks.includes(id)
     ? bookmarks.filter(x=>x!==id)
     : [...bookmarks,id];
   setBookmarks(next);
   localStorage.setItem('physics-bookmarks',JSON.stringify(next));
 };

 const years=[...new Set(allQuestions.map(q=>q.year).filter(Boolean))]
   .map(String)
   .sort((a,b)=>Number(b)-Number(a));

 const qs=allQuestions
   .filter(q=>{
     const qChapter=q.chapterId || q.chapter;
     const qType=String(q.type||'').toUpperCase();
     const text=String(
       `${q.q||''} ${q.concept||''} ${q.chapterTitle||''} ${q.source||''}`
     ).toLowerCase();

     const matchesScope=scope==='all'||qChapter===scope;
     const matchesType=type==='all'||qType===type;
     const matchesYear=year==='all'||String(q.year)===year;
     const matchesImportance=
       importance==='all' ||
       (importance==='high' && Number(q.importance)>=3) ||
       (importance==='medium' && Number(q.importance)===2);
     const matchesSearch=!query||text.includes(query.toLowerCase());
     const matchesBookmark=!showBookmarks||bookmarks.includes(q.id);

     return matchesScope&&matchesType&&matchesYear&&
       matchesImportance&&matchesSearch&&matchesBookmark;
   })
   .sort((a,b)=>
     (Number(b.importance)||0)-(Number(a.importance)||0) ||
     (Number(b.year)||0)-(Number(a.year)||0)
   );

 const mcqCount=qs.filter(q=>String(q.type||'').toUpperCase()==='MCQ').length;
 const cqCount=qs.filter(q=>String(q.type||'').toUpperCase()==='CQ').length;

 const reset=()=>{
   setScope('all');
   setType('all');
   setYear('all');
   setImportance('all');
   setQuery('');
   setShowBookmarks(false);
 };

 return (
  <div className="question-bank">
   <section className="qb-hero">
    <div>
     <span className="kicker">PRACTICE ZONE • QUESTION BANK</span>
     <h2>প্রশ্ন ব্যাংক</h2>
     <p>MCQ, CQ, previous questions এবং concept-based practice এক জায়গায়।</p>
    </div>
    <div className="qb-total">
     <b>{allQuestions.length}</b>
     <span>Total Questions</span>
    </div>
   </section>

   <section className="qb-toolbar">
    <div className="qb-search">
     <span>⌕</span>
     <input
       value={query}
       onChange={e=>setQuery(e.target.value)}
       placeholder="প্রশ্ন / concept / source খুঁজুন..."
     />
    </div>

    <div className="qb-filters">
