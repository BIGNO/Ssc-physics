function DiagramSVG({type,values}) {
  const v1 = Math.max(0.1, Number(values?.value1) || 5);
  const v2 = Math.max(0.1, Number(values?.value2) || 10);
  const angle = Math.max(0, Math.min(89, Number(values?.angle) || 30));

  const markerId =
    `physics-arrow-${String(values?.label || "physics")
      .replace(/[^a-zA-Z0-9]/g, "")
      .slice(0,16)}-${type}`;

  const glowId = `physics-glow-${type}`;

  const common = {
    viewBox: "0 0 760 430",
    className: "physics-lab-svg"
  };

  const Defs = () => (
    <defs>
      <marker
        id={markerId}
        markerWidth="12"
        markerHeight="12"
        refX="9"
        refY="5"
        orient="auto"
        markerUnits="strokeWidth"
      >
        <path d="M0,0 L0,10 L11,5 z" className="arrow-head" />
      </marker>

      <filter id={glowId} x="-50%" y="-50%" width="200%" height="200%">
        <feGaussianBlur stdDeviation="3.2" result="blur"/>
        <feMerge>
          <feMergeNode in="blur"/>
          <feMergeNode in="SourceGraphic"/>
        </feMerge>
      </filter>
    </defs>
  );

  const LabFrame = ({children,title,subtitle}) => (
    <svg {...common}>
      <Defs/>

      <rect
        x="12"
        y="12"
        width="736"
        height="406"
        rx="28"
        className="lab-frame"
      />

      <g className="lab-grid">
        {Array.from({length:15}).map((_,i)=>(
          <line
            key={`v-${i}`}
            x1={40+i*50}
            y1="42"
            x2={40+i*50}
            y2="388"
          />
        ))}
        {Array.from({length:8}).map((_,i)=>(
          <line
            key={`h-${i}`}
            x1="40"
            y1={48+i*44}
            x2="720"
            y2={48+i*44}
          />
        ))}
      </g>

      <text x="46" y="58" className="lab-kicker">
        PHYSICS LAB
      </text>

      <text x="46" y="88" className="lab-title">
        {title}
      </text>

      {subtitle && (
        <text x="46" y="112" className="lab-subtitle">
          {subtitle}
        </text>
      )}

      <g>{children}</g>
    </svg>
  );

  if (type === "motion") {
    const speed = Math.min(240, 30 + v2 * 13);
    const curveHeight = Math.min(160, 35 + v1 * 7);

    return (
      <LabFrame
        title="Motion & Velocity"
        subtitle={`speed = ${v2} ${values?.unit2 || "m/s"} • distance = ${v1} ${values?.unit1 || "m"}`}
      >
        <line x1="70" y1="330" x2="690" y2="330" className="axis"/>
        <line x1="90" y1="350" x2="90" y2="145" className="axis"/>

        <text x="650" y="355" className="axis-label">t</text>
        <text x="68" y="138" className="axis-label">x</text>

        <path
          d={`M90 315 Q250 ${315-curveHeight/2} 390 ${315-curveHeight*0.82} T680 ${315-curveHeight}`}
          className="motion-curve"
        />

        <circle cx="160" cy="282" r="18" className="motion-object">
          <animate
            attributeName="cx"
            values="160;640;160"
            dur="4s"
            repeatCount="indefinite"
          />
        </circle>

        <line
          x1="170"
          y1="282"
          x2={170+speed}
          y2="282"
          className="vector-primary"
          markerEnd={`url(#${markerId})`}
          filter={`url(#${glowId})`}
        />

        <text x="190" y="262" className="value-primary">
          v = {v2} {values?.unit2 || "m/s"}
        </text>

        <text x="98" y="378" className="measurement">
          Distance → {v1} {values?.unit1 || "m"}
        </text>
      </LabFrame>
    );
  }

  if (type === "wave") {
    const amp = Math.min(92, 25 + v2 * 4);
    const wavelength = Math.max(72, 220 - v1 * 9);

    let d = "M70 235";

    for (let x = 70; x <= 690; x += 7) {
      const y =
        235 +
        amp * Math.sin(((x-70)/wavelength) * Math.PI * 2);

      d += ` L${x} ${y}`;
    }

    return (
      <LabFrame
        title="Wave Motion"
        subtitle={`amplitude = ${v2} • wavelength = ${v1}`}
      >
        <line x1="70" y1="235" x2="690" y2="235" className="axis"/>

        <path
          d={d}
          className="wave-line"
          filter={`url(#${glowId})`}
        >
          <animate
            attributeName="stroke-dashoffset"
            from="0"
            to="-160"
            dur="2.2s"
            repeatCount="indefinite"
          />
        </path>

        <line
          x1="125"
          y1={235-amp}
          x2="125"
          y2="235"
          className="measurement-line"
        />

        <text x="138" y={220-amp} className="value-accent">
          A = {v2}
        </text>

        <line
          x1="220"
          y1="315"
          x2={220+wavelength}
          y2="315"
          className="measurement-line"
        />

        <text x="238" y="340" className="measurement">
          λ = {v1}
        </text>
      </LabFrame>
    );
  }

  if (type === "circuit") {
    const resistance = v2;
    const voltage = v1;
    const current = voltage / resistance;

    return (
      <LabFrame
        title="Electric Circuit"
        subtitle={`V = ${voltage} V • R = ${resistance} Ω • I = ${current.toFixed(2)} A`}
      >
        <path
          d="M150 160 H575 V325 H150 Z"
          className="circuit-wire"
        />

        <line x1="150" y1="160" x2="150" y2="205" className="circuit-wire"/>

        <line x1="136" y1="205" x2="136" y2="280" className="battery-line"/>
        <line x1="164" y1="220" x2="164" y2="265" className="battery-line"/>

        <text x="112" y="305" className="component-label">Battery</text>

        <rect
          x="332"
          y="140"
          width="105"
          height="40"
          rx="10"
          className="resistor-body"
        />

        <path
