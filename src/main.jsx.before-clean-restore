            >
              {n}°C
            </text>
          </g>
        ))}

        <text x="255" y="380" className="value-accent">
          Temperature = {temperature}°C
        </text>
      </LabFrame>
    );
  }

  if (type === "atom") {
    const electrons = Math.max(1, Math.min(12, Math.round(v1)));

    const ePositions = [];

    for (let i=0;i<electrons;i++) {
      const shell = i < 2 ? 95 : 155;
      const count = i < 2 ? Math.min(2,electrons) : Math.max(1,electrons-2);
      const index = i < 2 ? i : i-2;
      const a = (index/count)*Math.PI*2;

      ePositions.push({
        x: 380 + shell*Math.cos(a),
        y: 245 + shell*Math.sin(a),
        shell
      });
    }

    return (
      <LabFrame
        title="Atomic Structure"
        subtitle={`electrons = ${electrons}`}
      >
        <circle cx="380" cy="245" r="42" className="nucleus"/>
        <text x="363" y="252" className="nucleus-text">NUCLEUS</text>

