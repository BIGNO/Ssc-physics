        </text>

        <text x="384" y="166" className="value-secondary">
          W = mg
        </text>

        <path
          d="M370 320 A42 42 0 0 1 410 308"
          className="angle-arc"
        />

        <text x="416" y="318" className="measurement">
          {angle}°
        </text>
      </LabFrame>
    );
  }

  if (type === "lens" || type === "mirror") {
    const u = Math.max(1, v1);
    const f = Math.max(.5, v2);

    const focusGap = Math.min(105, 40 + f * 7);
    const objectX = 155;

    const opticalX = type === "lens" ? 380 : 500;

    const imageX =
      type === "lens"
        ? Math.min(655, opticalX + Math.max(55, focusGap*1.8))
        : Math.max(95, opticalX - Math.max(70, focusGap*1.55));

    const imageHeight =
      Math.min(120, Math.max(35, 260/(1+Math.abs(u/f-1))));

    return (
      <LabFrame
        title={type === "lens" ? "Lens & Ray Diagram" : "Mirror & Ray Diagram"}
        subtitle={`u = ${u} • f = ${f}`}
