      <section className="learning-flow">

        <div>
          <span>01</span>
          <b>Concept</b>
          <small>Understand the idea</small>
        </div>

        <strong>→</strong>

        <div>
          <span>02</span>
          <b>Formula</b>
          <small>Learn the equation</small>
        </div>

        <strong>→</strong>

        <div>
          <span>03</span>
          <b>Diagram</b>
          <small>Visualize it</small>
        </div>

        <strong>→</strong>

        <div>
          <span>04</span>
          <b>Practice</b>
          <small>Solve questions</small>
        </div>

      </section>

    </div>
  );
}

