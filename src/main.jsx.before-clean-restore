  }

  if (type === "energy") {
    const mass = v1;
    const height = v2;
    const pe = mass * 9.8 * height;
    const barHeight = Math.min(210, 30 + pe/7);

    return (
      <LabFrame
        title="Potential Energy"
        subtitle={`m = ${mass} kg • h = ${height} m • g = 9.8 m/s²`}
      >
        <line x1="100" y1="345" x2="680" y2="345" className="surface-line"/>

        <rect
          x="150"
          y={345-barHeight}
          width="125"
          height={barHeight}
          rx="16"
          className="energy-column"
        />

        <text x="158" y="370" className="component-label">
          mgh
        </text>

        <text x="140" y={330-barHeight} className="value-accent">
