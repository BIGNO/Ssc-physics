          x2="470"
          y2="155"
          className="height-line"
        />

        <line
          x1="458"
          y1="155"
          x2="482"
          y2="155"
          className="height-cap"
        />

        <rect
          x="430"
          y="270"
          width="80"
          height="75"
          rx="12"
          className="energy-object"
        />

        <text x="444" y="315" className="block-text">
          {mass} kg
        </text>

        <text x="505" y="175" className="value-primary">
          h = {height} m
        </text>
      </LabFrame>
    );
  }

  if (type === "heat") {
    const temperature = Math.max(-20, Math.min(150, v1));
    const fill = Math.max(15, Math.min(175, ((temperature+20)/170)*175));

    return (
      <LabFrame
        title="Temperature"
        subtitle={`T = ${temperature}°C`}
      >
        <rect
          x="315"
          y="125"
          width="70"
          height="200"
          rx="35"
          className="thermo-glass"
        />

        <rect
          x="337"
          y={305-fill}
          width="26"
          height={fill}
          rx="13"
          className="thermo-fluid"
        />

        <circle
          cx="350"
          cy="330"
          r="50"
          className="thermo-bulb"
        />

        <circle
          cx="350"
          cy="330"
          r="31"
          className="thermo-fluid"
