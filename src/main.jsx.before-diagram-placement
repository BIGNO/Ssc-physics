    </div>
    <div className="qb-total">
     <b>{allQuestions.length}</b>
     <span>Total Questions</span>
    </div>
   </section>

   <section className="qb-toolbar">
    <div className="qb-search">
     <span>⌕</span>
     <input
       value={query}
       onChange={e=>setQuery(e.target.value)}
       placeholder="প্রশ্ন / concept / source খুঁজুন..."
     />
    </div>

    <div className="qb-filters">
     <select value={scope} onChange={e=>setScope(e.target.value)}>
      <option value="all">সব Chapter</option>
      {chapters.map(c=><option key={c.id} value={c.id}>
       Chapter {c.no} — {c.title}
      </option>)}
     </select>

     <select value={type} onChange={e=>setType(e.target.value)}>
      <option value="all">MCQ + CQ</option>
      <option value="MCQ">শুধু MCQ</option>
      <option value="CQ">শুধু CQ</option>
     </select>

     <select value={year} onChange={e=>setYear(e.target.value)}>
      <option value="all">সব Year</option>
      {years.map(y=><option key={y} value={y}>{y}</option>)}
     </select>

     <select value={importance} onChange={e=>setImportance(e.target.value)}>
      <option value="all">সব Importance</option>
      <option value="high">High Priority</option>
      <option value="medium">Medium Priority</option>
     </select>
    </div>

    <div className="qb-actions">
     <button
       className={showBookmarks?'filter-active':''}
       onClick={()=>setShowBookmarks(!showBookmarks)}
     >
       ★ Bookmarks ({bookmarks.length})
     </button>
     <button onClick={reset}>Reset</button>
    </div>
   </section>

   <section className="qb-stats">
    <div><b>{qs.length}</b><span>Showing</span></div>
    <div><b>{mcqCount}</b><span>MCQ</span></div>
    <div><b>{cqCount}</b><span>CQ</span></div>
    <div><b>{bookmarks.length}</b><span>Saved</span></div>
   </section>

   <div className="qb-list">
    {qs.length ? qs.map(q=>
      <QuestionCard
        q={q}
        key={q.id}
        bookmarked={bookmarks.includes(q.id)}
        onBookmark={()=>toggleBookmark(q.id)}
      />
    ) : (
      <div className="qb-empty">
       <div>∅</div>
       <h3>কোনো প্রশ্ন পাওয়া যায়নি</h3>
       <p>Filter বা search পরিবর্তন করে আবার চেষ্টা করো।</p>
       <button onClick={reset}>সব Filter Reset</button>
      </div>
    )}
   </div>
  </div>
 )
}


const studyBookKey='physics-study-book-v1';

function loadStudyBook(){
  try{
    return JSON.parse(
      localStorage.getItem(studyBookKey) ||
      '{"mistakes":[],"revision":[]}'
    );
  }catch{
    return {mistakes:[],revision:[]};
  }
}

function saveStudyBook(book){
  localStorage.setItem(
    studyBookKey,
    JSON.stringify(book)
  );
  window.dispatchEvent(
    new Event('physics-study-updated')
  );
}

function todayISO(){
  return new Date().toISOString().slice(0,10);
}

function addDaysISO(days){
  const d=new Date();
  d.setDate(d.getDate()+days);
  return d.toISOString().slice(0,10);
}

function studyQuestionSnapshot(q){
  return {
    id:String(q.id),
    q:q.q,
    type:q.type||'',
    year:q.year||'',
    source:q.source||'PDF Question Bank',
    concept:q.concept||'Physics',
    chapterId:q.chapterId||q.chapter||'',
    answer:q.answer||'',
    solution:q.solution||'',
    options:q.options||[]
  };
}

function StudyControls({q}){
  const [,refresh]=useState(0);
  const id=String(q.id);
  const book=loadStudyBook();

  const mistake=book.mistakes.some(
    x=>String(x.id)===id
  );

  const revision=book.revision.find(
    x=>String(x.id)===id
  );

  const toggleMistake=()=>{
    const b=loadStudyBook();

    if(b.mistakes.some(x=>String(x.id)===id)){
      b.mistakes=b.mistakes.filter(
        x=>String(x.id)!==id
      );
    }else{
      b.mistakes.push({
        ...studyQuestionSnapshot(q),
        addedAt:todayISO()
      });
    }

    saveStudyBook(b);
    refresh(v=>v+1);
  };

  const addRevision=(days)=>{
    const b=loadStudyBook();

    b.revision=b.revision.filter(
      x=>String(x.id)!==id
    );

    b.revision.push({
      ...studyQuestionSnapshot(q),
      addedAt:todayISO(),
      nextReview:addDaysISO(days),
      interval:days
    });

    saveStudyBook(b);
    refresh(v=>v+1);
  };

  const removeRevision=()=>{
    const b=loadStudyBook();

    b.revision=b.revision.filter(
      x=>String(x.id)!==id
    );

    saveStudyBook(b);
    refresh(v=>v+1);
  };

  return (
    <div className="study-actions">

      <button
        type="button"
        className={`study-btn ${mistake?'active':''}`}
        onClick={toggleMistake}
      >
        {mistake
          ? '✓ Mistake Book-এ আছে'
          : '+ Mistake Book'}
      </button>

      {revision ? (
        <button
          type="button"
          className="study-btn active"
          onClick={removeRevision}
        >
          ✓ Revision: {revision.nextReview}
        </button>
      ) : (
        <>
          <button
            type="button"
            className="study-btn"
            onClick={()=>addRevision(1)}
          >
            Revision 1d
          </button>

          <button
            type="button"
            className="study-btn"
            onClick={()=>addRevision(3)}
          >
            Revision 3d
          </button>

          <button
            type="button"
            className="study-btn"
            onClick={()=>addRevision(7)}
          >
            Revision 7d
          </button>
        </>
      )}

    </div>
  );
}

function QuestionCard({q,bookmarked,onBookmark}){
