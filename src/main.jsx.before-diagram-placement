function DiagramSVG({type,values,compact=false}) {
  const v1 = clampNumber(values?.value1, 0.1, 1000, 5);
  const v2 = clampNumber(values?.value2, 0.1, 1000, 10);
  const angle = clampNumber(values?.angle, 0, 89, 30);

  const markerId = `arrow-${String(values?.label || "physics")
    .replace(/[^a-zA-Z0-9]/g, "")
    .slice(0,20)}-${type}-${compact ? "c" : "b"}`;

  const common = {
    width: compact ? 420 : 700,
    height: compact ? 260 : 380,
    viewBox: compact ? "0 0 700 380" : "0 0 700 380",
    className: "diagram-svg"
  };

  if (type === "motion") {
    const rise = Math.min(220, 50 + v1 * 18);
    const speed = Math.min(300, 50 + v2 * 10);

    return (
      <svg {...common}>
        <defs>
          <marker id={markerId} markerWidth="8" markerHeight="8" refX="6" refY="3" orient="auto">
            <path d="M0,0 L0,6 L7,3 z" />
          </marker>
        </defs>

        <line x1="80" y1="300" x2="620" y2="300" />
        <line x1="100" y1="330" x2="100" y2="70" />

        <path
          d={`M100 290 Q260 ${290-rise/2} 400 ${290-rise*0.8} T620 ${290-rise}`}
          fill="none"
        />

        <line
          x1="170"
          y1="240"
          x2={170 + speed}
          y2="240"
          markerEnd={`url(#${markerId})`}
        />

        <circle cx="170" cy="240" r="14" className="diagram-object" />
        <text x="130" y="365">Time</text>
        <text x="45" y="90">Position</text>
        <text x="185" y="225">v = {v2} {values?.unit2 || "m/s"}</text>
        <text x="120" y="120">{values?.label || "Motion"}</text>
      </svg>
    );
  }

  if (type === "wave") {
    const amp = Math.min(100, 25 + v2 * 5);
    const wavelength = Math.max(80, 260 - v1 * 12);

    let d = "M40 190";
    for (let x = 40; x <= 660; x += 8) {
      const y =
        190 +
        amp * Math.sin(((x - 40) / wavelength) * Math.PI * 2);
      d += ` L${x} ${y}`;
    }

    return (
      <svg {...common}>
        <line x1="40" y1="190" x2="660" y2="190" />
        <path d={d} fill="none" />
        <line x1="100" y1={190-amp} x2="100" y2={190} />
        <line x1="100" y1={190-amp} x2="150" y2={190-amp} />
        <text x="165" y={185-amp}>Amplitude = {v2}</text>
        <text x="250" y="225">Wavelength = {v1}</text>
        <text x="260" y="95">{values?.label || "Wave"}</text>
      </svg>
    );
  }

  if (type === "circuit") {
    const voltage = v1;
    const resistance = Math.max(0.1, v2);
    const current = voltage / resistance;
    const arrowLen = Math.min(180, 40 + current * 18);

    return (
      <svg {...common}>
        <defs>
          <marker id={markerId} markerWidth="8" markerHeight="8" refX="6" refY="3" orient="auto">
            <path d="M0,0 L0,6 L7,3 z" />
          </marker>
        </defs>

        <line x1="120" y1="100" x2="580" y2="100" />
        <line x1="120" y1="300" x2="580" y2="300" />
        <line x1="120" y1="100" x2="120" y2="175" />
        <line x1="120" y1="225" x2="120" y2="300" />
        <line x1="580" y1="100" x2="580" y2="165" />
        <line x1="580" y1="235" x2="580" y2="300" />

        <line x1="108" y1="175" x2="108" y2="225" />
        <line x1="132" y1="165" x2="132" y2="235" />

        <rect x="335" y="82" width="100" height="36" rx="8" />
        <text x="354" y="106">R = {resistance} Ω</text>

        <line
          x1="265"
          y1="100"
          x2={265 + arrowLen}
          y2="100"
          markerEnd={`url(#${markerId})`}
        />

        <text x="245" y="70">I = {current.toFixed(2)} A</text>
        <text x="85" y="150">V = {voltage} V</text>
        <text x="260" y="355">{values?.label || "Circuit"}</text>
      </svg>
    );
  }

  if (type === "force") {
    const mass = Math.max(0.1, v1);
    const force = Math.max(0.1, v2);
    const forceLen = Math.min(220, 50 + force * 12);

    const rad = angle * Math.PI / 180;
    const x2 = 350 + forceLen * Math.cos(rad);
    const y2 = 250 - forceLen * Math.sin(rad);

    return (
      <svg {...common}>
        <defs>
          <marker id={markerId} markerWidth="8" markerHeight="8" refX="6" refY="3" orient="auto">
            <path d="M0,0 L0,6 L7,3 z" />
          </marker>
        </defs>

        <line x1="90" y1="310" x2="620" y2="310" />
        <rect x="275" y="220" width="150" height="90" rx="10" className="diagram-object" />

        <line
          x1="350"
          y1="250"
          x2={x2}
          y2={y2}
          markerEnd={`url(#${markerId})`}
        />

        <line
          x1="350"
          y1="250"
          x2="350"
          y2="150"
          markerEnd={`url(#${markerId})`}
        />

        <text x="305" y="270">m = {mass} kg</text>
        <text x={x2 - 30} y={y2 - 10}>F = {force} N</text>
        <text x="355" y="145">Weight</text>
        <text x="300" y="350">θ = {angle}°</text>
        <text x="270" y="70">{values?.label || "Force"}</text>
      </svg>
    );
  }

  if (type === "lens" || type === "mirror") {
    const u = Math.max(1, v1);
    const f = Math.max(0.5, v2);

    const objectX = 140;
    const opticalX = 350;
    const imageX = type === "lens"
      ? Math.min(610, opticalX + Math.max(40, (u * f) / Math.max(1, u - f) * 18))
      : Math.max(60, opticalX - Math.max(40, (u * f) / Math.max(1, Math.abs(u - f)) * 10));

    const imageH = Math.min(130, 30 + Math.abs(v2) * 5);

    return (
      <svg viewBox="0 0 700 420" className="diagram-svg">
        <line x1="60" y1="210" x2="640" y2="210" />

        {type === "lens" ? (
          <>
            <path d="M345 90 Q365 210 345 330 Q335 300 335 210 Q335 120 345 90" />
            <path d="M355 90 Q335 210 355 330 Q365 300 365 210 Q365 120 355 90" />
            <text x="315" y="70">Lens</text>
          </>
        ) : (
          <>
            <path d="M350 70 Q300 210 350 350" fill="none" />
            <line x1="355" y1="70" x2="355" y2="350" />
            <text x="300" y="55">Concave / Mirror</text>
          </>
        )}

        <line x1={objectX} y1="210" x2={objectX} y2={210-imageH} />
        <line x1={objectX-16} y1={210-imageH} x2={objectX+16} y2={210-imageH} />
        <text x={objectX-35} y={185-imageH}>Object</text>

        <line x1={imageX} y1="210" x2={imageX} y2={210-imageH} />
        <line x1={imageX-16} y1={210-imageH} x2={imageX+16} y2={210-imageH} />
        <text x={imageX-25} y={190-imageH}>Image</text>

        <line x1={objectX} y1={210-imageH} x2={imageX} y2={210-imageH/2} />
        <line x1={objectX} y1={210} x2={imageX} y2={210-imageH/2} />

        <text x="85" y="385">u = {u}</text>
        <text x="270" y="385">f = {f}</text>
        <text x="480" y="385">{values?.label || type}</text>
      </svg>
    );
  }

  if (type === "energy") {
    const mass = Math.max(0.1, v1);
    const height = Math.max(0.1, v2);
    const g = 9.8;
    const pe = mass * g * height;
    const bar = Math.min(240, 30 + pe / 8);

    return (
      <svg viewBox="0 0 700 400" className="diagram-svg">
        <line x1="120" y1="330" x2="580" y2="330" />
        <rect x="180" y={330-bar} width="130" height={bar} className="energy-bar" />
        <text x="195" y="355">Potential Energy</text>
        <text x="185" y={315-bar}>mgh = {pe.toFixed(1)} J</text>

        <rect x="410" y="245" width="80" height="80" rx="8" className="diagram-object" />
        <line x1="450" y1="245" x2="450" y2="120" />
        <text x="395" y="105">h = {height} m</text>
        <text x="405" y="215">m = {mass} kg</text>
        <text x="275" y="70">{values?.label || "Energy"}</text>
      </svg>
    );
  }

  if (type === "heat") {
    const temperature = clampNumber(v1, -100, 200, 25);
    const fill = Math.min(240, Math.max(10, (temperature + 50) * 1.5));

    return (
      <svg viewBox="0 0 700 400" className="diagram-svg">
        <rect x="315" y="80" width="70" height="240" rx="35" className="thermometer" />
        <circle cx="350" cy="330" r="45" className="thermometer" />
        <rect x="335" y={300-fill/2} width="30" height={Math.min(180, fill/2)} rx="15" />
        <circle cx="350" cy="330" r="25" />
        <text x="420" y="200">
          T = {temperature}°C
        </text>
        <text x="250" y="55">{values?.label || "Heat"}</text>
        <line x1="400" y1="100" x2="400" y2="320" />
        <text x="410" y="110">100°C</text>
        <text x="410" y="215">50°C</text>
        <text x="410" y="320">0°C</text>
      </svg>
    );
  }

  if (type === "atom") {
    const electrons = Math.max(1, Math.min(12, Math.round(v1)));
    const shell1 = Math.min(2, electrons);
    const shell2 = Math.max(0, electrons - shell1);

    const positions = [];

    for (let i = 0; i < shell1; i++) {
      const a = (i / Math.max(1, shell1)) * Math.PI * 2;
      positions.push({
        x: 350 + 85 * Math.cos(a),
        y: 200 + 85 * Math.sin(a)
      });
    }

    for (let i = 0; i < shell2; i++) {
      const a = (i / Math.max(1, shell2)) * Math.PI * 2;
      positions.push({
        x: 350 + 155 * Math.cos(a),
        y: 200 + 155 * Math.sin(a)
      });
    }

    return (
      <svg viewBox="0 0 700 400" className="diagram-svg">
        <circle cx="350" cy="200" r="34" className="nucleus" />
        <text x="337" y="205">N</text>
        <circle cx="350" cy="200" r="85" className="atom-shell" />
        <circle cx="350" cy="200" r="155" className="atom-shell" />

        {positions.map((p, i) => (
          <circle
            key={i}
            cx={p.x}
            cy={p.y}
            r="8"
            className="electron"
          />
        ))}

        <text x="275" y="55">{values?.label || "Atom"}</text>
        <text x="270" y="365">Electrons = {electrons}</text>
      </svg>
    );
  }

  if (type === "magnet") {
    const strength = clampNumber(v1, 1, 20, 5);
    const spread = Math.max(20, 60 - strength * 2);

    return (
      <svg viewBox="0 0 700 400" className="diagram-svg">
        <rect x="275" y="165" width="70" height="70" rx="8" />
        <rect x="355" y="165" width="70" height="70" rx="8" />
        <text x="298" y="207">N</text>
        <text x="380" y="207">S</text>

        {[0,1,2,3,4].map((i) => (
          <path
            key={i}
            d={`M${275-i*spread} 165
                Q350 ${45-i*10} ${425+i*spread} 165`}
            fill="none"
            className="field-line"
          />
        ))}

        {[0,1,2,3,4].map((i) => (
          <path
            key={`b${i}`}
            d={`M${275-i*spread} 235
                Q350 ${355+i*10} ${425+i*spread} 235`}
            fill="none"
            className="field-line"
          />
        ))}

        <text x="250" y="70">Magnetic field</text>
        <text x="285" y="320">Strength = {strength}</text>
      </svg>
    );
  }

  return (
    <svg viewBox="0 0 700 400" className="diagram-svg">
      <defs>
        <marker id={markerId} markerWidth="8" markerHeight="8" refX="6" refY="3" orient="auto">
          <path d="M0,0 L0,6 L7,3 z" />
        </marker>
      </defs>

      <rect
        x={220}
        y={150}
        width={Math.min(180, 80 + v1 * 8)}
        height={Math.min(120, 50 + v1 * 5)}
        rx="12"
        className="diagram-object"
      />

      <line
        x1="180"
        y1="210"
        x2={180 + Math.min(220, 50 + v2 * 12)}
        y2="210"
        markerEnd={`url(#${markerId})`}
      />

      <text x="255" y="100">{values?.label || "Physics"}</text>
      <text x="230" y="305">
        Value 1 = {values?.value1} {values?.unit1}
      </text>
      <text x="230" y="330">
        Value 2 = {values?.value2} {values?.unit2}
      </text>
    </svg>
  );
}

