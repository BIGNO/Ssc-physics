          <span>Mistake Book</span>
          <b>{book.mistakes.length}</b>
        </div>

        <div className="progress-stat">
          <span>Total Revision</span>
          <b>{book.revision.length}</b>
        </div>

        <div className="progress-stat danger">
          <span>Due Today</span>
          <b>{due.length}</b>
        </div>

      </div>

      <section className="panel">

        <div className="panel-head">
          <div>
            <span className="kicker">
              CHAPTER PROGRESS
            </span>

            <h2>
              Chapter-wise progress
            </h2>
          </div>
        </div>

        <div className="chapter-progress-list">

          {chapters.map(c=>{

