                  borderRadius:"12px",
                  background:"#090d12"
                }}
              >
                <span style={{
                  display:"block",
                  fontSize:"10px",
                  letterSpacing:"1.5px",
                  opacity:.5
                }}>
                  PRIMARY METRIC
                </span>

                <strong style={{
                  display:"block",
                  marginTop:"5px",
                  fontSize:"20px"
                }}>
                  {metric}
                </strong>
              </div>

              <div
                style={{
                  padding:"12px 14px",
                  border:"1px solid #26323d",
                  borderRadius:"12px",
                  background:"#090d12",
                  minWidth:"120px"
                }}
              >
                <span style={{
                  display:"block",
                  fontSize:"10px",
                  letterSpacing:"1.5px",
                  opacity:.5
                }}>
                  STATUS
                </span>

                <strong style={{
                  display:"block",
                  marginTop:"5px",
