function detectDiagramModel(chapter, concept) {
  const text = `${chapter.title} ${chapter.focus} ${concept?.title || ""}`.toLowerCase();

  if (
    text.includes("পরিমাপ") ||
    text.includes("ভৌত রাশি") ||
    text.includes("একক") ||
    text.includes("মাত্রা") ||
    text.includes("ruler") ||
    text.includes("measurement")
  ) return "measurement";

  if (
    text.includes("ভরবেগ") ||
    text.includes("momentum")
  ) return "momentum";

  if (
    text.includes("গতি") ||
    text.includes("দূরত্ব") ||
    text.includes("সরণ") ||
    text.includes("বেগ") ||
    text.includes("ত্বরণ") ||
    text.includes("speed") ||
    text.includes("velocity") ||
    text.includes("acceleration") ||
    text.includes("motion")
  ) return "motion";

  if (
    text.includes("বল") ||
    text.includes("নিউটন") ||
    text.includes("ঘর্ষণ") ||
    text.includes("inertia") ||
    text.includes("force")
  ) return "force";

  if (
    text.includes("কাজ") ||
    text.includes("শক্তি") ||
    text.includes("ক্ষমতা") ||
    text.includes("power") ||
    text.includes("energy") ||
    text.includes("work")
  ) return "energy";

  if (
    text.includes("ঘনত্ব") ||
    text.includes("density")
  ) return "density";

  if (
    text.includes("চাপ") ||
    text.includes("pressure")
  ) return "pressure";

  if (
    text.includes("তরঙ্গ") ||
    text.includes("wave")
  ) return "wave";

  if (
    text.includes("শব্দ") ||
    text.includes("sound") ||
    text.includes("কম্পন")
  ) return "sound";

  if (
    text.includes("প্রতিফলন") ||
    text.includes("আয়না") ||
    text.includes("দর্পণ") ||
    text.includes("reflection") ||
    text.includes("mirror")
  ) return "reflection";

  if (
    text.includes("প্রতিসরণ") ||
    text.includes("প্রতিসারক") ||
    text.includes("refraction")
  ) return "refraction";

  if (
    text.includes("লেন্স") ||
    text.includes("lens")
  ) return "lens";

  if (
    text.includes("বর্তনী") ||
    text.includes("সার্কিট") ||
    text.includes("তড়িৎ") ||
    text.includes("বিদ্যুৎ") ||
    text.includes("circuit") ||
    text.includes("resistance")
  ) return "circuit";

  if (
    text.includes("series") ||
    text.includes("parallel") ||
    text.includes("সমান্তরাল") ||
    text.includes("শ্রেণি")
  ) return "series";

  if (
    text.includes("চৌম্বক") ||
    text.includes("magnetic") ||
    text.includes("magnet")
  ) return "magnetic";

  if (
    text.includes("মোটর") ||
    text.includes("motor")
  ) return "motor";

  if (
    text.includes("জেনারেটর") ||
    text.includes("generator")
  ) return "generator";

  if (
    text.includes("ট্রান্সফরমার") ||
    text.includes("transformer")
  ) return "transformer";

  if (
    text.includes("তাপ") ||
    text.includes("temperature") ||
    text.includes("heat") ||
    text.includes("উষ্ণতা")
  ) return "heat";

  if (
    text.includes("পরমাণু") ||
    text.includes("পরমাণুর") ||
    text.includes("atom")
  ) return "atom";

  if (
    text.includes("তেজস্ক্রিয়") ||
    text.includes("radioactive") ||
    text.includes("radioactivity")
  ) return "radioactivity";

  if (
    text.includes("অর্ধপরিবাহী") ||
    text.includes("semiconductor") ||
    text.includes("p-n") ||
    text.includes("pn junction")
  ) return "semiconductor";

  if (
    text.includes("যন্ত্র") ||
    text.includes("লিভার") ||
    text.includes("pulley") ||
    text.includes("lever") ||
    text.includes("mechanical")
  ) return "machine";

  return "generic";
}

function defaultDiagramValues(model) {
  const base = {
    length: 88,
    objectDistance: 80,
    focalLength: 40,
    mass: 5,
    force: 40,
    velocity: 20,
    acceleration: 2,
    angle: 30,
    amplitude: 40,
    wavelength: 100,
    frequency: 2,
    voltage: 12,
    resistance: 6,
    depth: 60,
    density: 5,
    turns1: 10,
    turns2: 20,
    temperature: 50,
    height: 80,
    electrons: 3
  };

  if (model === "measurement") return { ...base, length: 88 };
  if (model === "motion") return { ...base, objectDistance: 70, velocity: 20, acceleration: 2 };
  if (model === "force") return { ...base, force: 50, mass: 5, angle: 20 };
  if (model === "momentum") return { ...base, mass: 5, velocity: 20 };
  if (model === "energy") return { ...base, mass: 5, height: 80 };
  if (model === "density") return { ...base, density: 5, mass: 5 };
  if (model === "pressure") return { ...base, depth: 60 };
  if (model === "wave") return { ...base, amplitude: 40, wavelength: 110, frequency: 2 };
  if (model === "sound") return { ...base, amplitude: 35, frequency: 3 };
  if (model === "reflection") return { ...base, angle: 30 };
  if (model === "refraction") return { ...base, angle: 30 };
  if (model === "lens") return { ...base, objectDistance: 120, focalLength: 60 };
  if (model === "circuit") return { ...base, voltage: 12, resistance: 6 };
  if (model === "series") return { ...base, resistance: 6 };
  if (model === "magnetic") return { ...base, force: 50 };
  if (model === "motor") return { ...base, force: 50, angle: 20 };
  if (model === "generator") return { ...base, velocity: 20 };
  if (model === "transformer") return { ...base, turns1: 10, turns2: 20, voltage: 12 };
  if (model === "heat") return { ...base, temperature: 50 };
  if (model === "atom") return { ...base, electrons: 3 };
  if (model === "radioactivity") return { ...base, frequency: 3 };
  if (model === "semiconductor") return { ...base, voltage: 6 };
  if (model === "machine") return { ...base, force: 50 };
  return base;
}

function DiagramBoard({chapter,state,update}) {
  const concepts = chapter.concepts?.length
    ? chapter.concepts
    : [{
        id: `${chapter.id}-main`,
        title: chapter.title,
        focus: chapter.focus
      }];

  const [selectedId,setSelectedId] = useState(concepts[0]?.id);

  const selected =
    concepts.find(c => c.id === selectedId) || concepts[0];

  const model = detectDiagramModel(chapter,selected);

  const savedChapter = state.diagrams?.[chapter.id] || {};
  const savedByConcept = savedChapter.byConcept || {};

  const savedValues = savedByConcept[selected.id];
  const defaults = defaultDiagramValues(model);

  const values = {
    ...defaults,
    ...(savedValues || {})
  };

  const change = (key,value) => {
    const nextValues = {
      ...values,
      [key]: value
    };

    update({
      diagrams:{
        ...state.diagrams,
        [chapter.id]:{
          ...savedChapter,
          byConcept:{
            ...savedByConcept,
            [selected.id]: nextValues
          }
        }
      }
    });
  };

  const reset = () => {
    update({
      diagrams:{
        ...state.diagrams,
        [chapter.id]:{
          ...savedChapter,
          byConcept:{
            ...savedByConcept,
            [selected.id]: defaults
          }
        }
      }
    });
  };

  const metric = (() => {
    if (model === "measurement") return `L = ${Number(values.length).toFixed(0)} cm`;
    if (model === "motion") return `v = ${Number(values.velocity).toFixed(1)} m/s`;
    if (model === "force") return `F = ${Number(values.force).toFixed(0)} N`;
    if (model === "momentum") return `p = ${(Number(values.mass)*Number(values.velocity)).toFixed(0)} kg·m/s`;
    if (model === "energy") return `E = ${(Number(values.mass)*9.8*Number(values.height)).toFixed(0)} J`;
    if (model === "pressure") return `Depth = ${Number(values.depth).toFixed(0)} cm`;
    if (model === "wave") return `λ = ${Number(values.wavelength).toFixed(0)} cm`;
    if (model === "circuit") {
      const I = Number(values.resistance)
        ? Number(values.voltage)/Number(values.resistance)
        : 0;
      return `I = ${I.toFixed(2)} A`;
    }
    if (model === "transformer") {
      const ratio = Number(values.turns1)
        ? Number(values.turns2)/Number(values.turns1)
        : 0;
      return `Vs ≈ ${(Number(values.voltage)*ratio).toFixed(1)} V`;
    }
    return `Angle = ${Number(values.angle || 0).toFixed(0)}°`;
  })();

  const controlMap = {
    measurement: [
      ["length","Length (cm)",10,200,1],
    ],
    motion: [
      ["objectDistance","Position (m)",0,200,1],
      ["velocity","Velocity (m/s)",0,100,1],
      ["acceleration","Acceleration (m/s²)",0,20,.5],
    ],
    force: [
      ["force","Force (N)",5,100,1],
      ["mass","Mass (kg)",1,50,1],
      ["angle","Direction (°)",0,90,1],
    ],
    momentum: [
      ["mass","Mass (kg)",1,50,1],
      ["velocity","Velocity (m/s)",0,100,1],
    ],
    energy: [
      ["mass","Mass (kg)",1,50,1],
      ["height","Height (m)",10,200,1],
    ],
    density: [
      ["density","Density",1,20,.5],
      ["mass","Mass (kg)",1,50,1],
    ],
    pressure: [
      ["depth","Depth (cm)",10,150,1],
    ],
    wave: [
      ["amplitude","Amplitude",10,90,1],
      ["wavelength","Wavelength",40,180,1],
      ["frequency","Frequency",1,10,1],
    ],
    sound: [
      ["amplitude","Amplitude",10,90,1],
      ["frequency","Frequency",1,10,1],
    ],
    reflection: [
      ["angle","Incident angle (°)",5,75,1],
    ],
    refraction: [
      ["angle","Incident angle (°)",5,75,1],
    ],
    lens: [
      ["objectDistance","Object distance (cm)",40,180,1],
      ["focalLength","Focal length (cm)",20,100,1],
    ],
    circuit: [
      ["voltage","Voltage (V)",1,24,1],
      ["resistance","Resistance (Ω)",1,30,1],
    ],
    series: [
      ["resistance","Resistance (Ω)",1,30,1],
    ],
    magnetic: [
      ["force","Field strength",10,100,1],
    ],
    motor: [
