     const qChapter=q.chapterId || q.chapter;
     const qType=String(q.type||'').toUpperCase();
     const text=String(
       `${q.q||''} ${q.concept||''} ${q.chapterTitle||''} ${q.source||''}`
     ).toLowerCase();

     const matchesScope=scope==='all'||qChapter===scope;
     const matchesType=type==='all'||qType===type;
     const matchesYear=year==='all'||String(q.year)===year;
     const matchesImportance=
       importance==='all' ||
       (importance==='high' && Number(q.importance)>=3) ||
       (importance==='medium' && Number(q.importance)===2);
     const matchesSearch=!query||text.includes(query.toLowerCase());
     const matchesBookmark=!showBookmarks||bookmarks.includes(q.id);

     return matchesScope&&matchesType&&matchesYear&&
       matchesImportance&&matchesSearch&&matchesBookmark;
   })
   .sort((a,b)=>
     (Number(b.importance)||0)-(Number(a.importance)||0) ||
     (Number(b.year)||0)-(Number(a.year)||0)
   );

 const mcqCount=qs.filter(q=>String(q.type||'').toUpperCase()==='MCQ').length;
 const cqCount=qs.filter(q=>String(q.type||'').toUpperCase()==='CQ').length;

 const reset=()=>{
   setScope('all');
   setType('all');
   setYear('all');
   setImportance('all');
   setQuery('');
   setShowBookmarks(false);
 };

 return (
  <div className="question-bank">
   <section className="qb-hero">
    <div>
     <span className="kicker">PRACTICE ZONE • QUESTION BANK</span>
     <h2>প্রশ্ন ব্যাংক</h2>
     <p>MCQ, CQ, previous questions এবং concept-based practice এক জায়গায়।</p>
    </div>
    <div className="qb-total">
     <b>{allQuestions.length}</b>
     <span>Total Questions</span>
    </div>
   </section>

   <section className="qb-toolbar">
    <div className="qb-search">
     <span>⌕</span>
     <input
       value={query}
       onChange={e=>setQuery(e.target.value)}
       placeholder="প্রশ্ন / concept / source খুঁজুন..."
     />
    </div>

    <div className="qb-filters">
     <select value={scope} onChange={e=>setScope(e.target.value)}>
      <option value="all">সব Chapter</option>
      {chapters.map(c=><option key={c.id} value={c.id}>
       Chapter {c.no} — {c.title}
      </option>)}
     </select>

     <select value={type} onChange={e=>setType(e.target.value)}>
      <option value="all">MCQ + CQ</option>
      <option value="MCQ">শুধু MCQ</option>
      <option value="CQ">শুধু CQ</option>
     </select>

     <select value={year} onChange={e=>setYear(e.target.value)}>
      <option value="all">সব Year</option>
      {years.map(y=><option key={y} value={y}>{y}</option>)}
     </select>

     <select value={importance} onChange={e=>setImportance(e.target.value)}>
      <option value="all">সব Importance</option>
      <option value="high">High Priority</option>
      <option value="medium">Medium Priority</option>
     </select>
    </div>

    <div className="qb-actions">
     <button
       className={showBookmarks?'filter-active':''}
       onClick={()=>setShowBookmarks(!showBookmarks)}
     >
       ★ Bookmarks ({bookmarks.length})
     </button>
     <button onClick={reset}>Reset</button>
    </div>
   </section>

   <section className="qb-stats">
    <div><b>{qs.length}</b><span>Showing</span></div>
    <div><b>{mcqCount}</b><span>MCQ</span></div>
    <div><b>{cqCount}</b><span>CQ</span></div>
    <div><b>{bookmarks.length}</b><span>Saved</span></div>
   </section>

   <div className="qb-list">
    {qs.length ? qs.map(q=>
      <QuestionCard
        q={q}
        key={q.id}
        bookmarked={bookmarks.includes(q.id)}
        onBookmark={()=>toggleBookmark(q.id)}
      />
    ) : (
      <div className="qb-empty">
       <div>∅</div>
       <h3>কোনো প্রশ্ন পাওয়া যায়নি</h3>
       <p>Filter বা search পরিবর্তন করে আবার চেষ্টা করো।</p>
       <button onClick={reset}>সব Filter Reset</button>
      </div>
    )}
   </div>
  </div>
 )
}

function QuestionCard({q,bookmarked,onBookmark}){
 const [open,setOpen]=useState(false);
 const type=String(q.type||'').toUpperCase();
 const hasAnswer=Boolean(q.answer && String(q.answer).trim());
 const priority=Number(q.importance)||0;

 return (
  <article className={`qcard-enhanced ${open?'opened':''}`}>
   <div className="q-top">
    <div className="q-meta-new">
     <span>{q.year || 'Year not specified'}</span>
     <span>{q.source || 'Question Bank'}</span>
     <span className={`q-type ${type==='MCQ'?'mcq':'cq'}`}>
      {type || 'QUESTION'}
     </span>
     {priority>=3 && <span className="priority-high">HIGH</span>}
    </div>

    <button
      type="button"
      className={`bookmark-btn ${bookmarked?'saved':''}`}
      onClick={onBookmark}
      title="Bookmark"
    >
      {bookmarked?'★':'☆'}
    </button>
   </div>

   {q.concept && <div className="q-concept">Concept: {q.concept}</div>}

   <h3>{q.q}</h3>

   {q.options && (
    <div className="options enhanced-options">
     {q.options.map((o,i)=>
      <div className="option-row" key={`${q.id}-opt-${i}`}>
       <span>{String.fromCharCode(0x0995+i)})</span>
       <span>{o}</span>
      </div>
     )}
    </div>
   )}

   <div className="q-footer">
    <button
      type="button"
      className="solution-btn"
      onClick={()=>setOpen(!open)}
    >
      {open ? '▲ Solution hide' : '▼ Answer / Solution দেখুন'}
    </button>

    <span className="source-label">
      {hasAnswer?'Answer available':'Answer not available'}
    </span>
   </div>

   {open && (
    <div className="solution enhanced-solution">
     <div>
      <b>Answer:</b>{' '}
      {hasAnswer
       ? q.answer
       : 'এই প্রশ্নের উত্তর source-এ পাওয়া যায়নি।'}
     </div>

     {q.solution && (
      <div className="solution-detail">
       <b>Solution:</b>
       <p>{q.solution}</p>
      </div>
     )}

     {!hasAnswer && !q.solution && (
      <div className="solution-note">
       Source-এ answer/solution না থাকায় এখানে নতুন উত্তর তৈরি করা হয়নি।
      </div>
     )}
    </div>
   )}
  </article>
 )
}


function ExamMode({chapters,allQuestions}){
 const [started,setStarted]=useState(false);
 const [submitted,setSubmitted]=useState(false);
 const [size,setSize]=useState(20);
 const [scope,setScope]=useState('all');
 const [timeLimit,setTimeLimit]=useState(20);
 const [examQuestions,setExamQuestions]=useState([]);
 const [current,setCurrent]=useState(0);
 const [answers,setAnswers]=useState({});
 const [seconds,setSeconds]=useState(0);

 const buildExam=()=>{
   let pool=allQuestions.filter(q=>{
     const c=q.chapterId||q.chapter;
     return scope==='all'||c===scope;
   }).filter(q=>String(q.type||'').toUpperCase()==='MCQ');

   pool=[...pool].sort(()=>Math.random()-0.5).slice(0,Number(size));

   if(!pool.length){
     alert('এই filter অনুযায়ী MCQ পাওয়া যায়নি।');
     return;
   }

   setExamQuestions(pool);
   setAnswers({});
   setCurrent(0);
   setSubmitted(false);
   setSeconds(Number(timeLimit)*60);
   setStarted(true);
 };

 const choose=(value)=>{
   if(submitted)return;
   const q=examQuestions[current];
   setAnswers({...answers,[q.id]:value});
 };

 const submit=()=>{
   setSubmitted(true);
 };

 React.useEffect(()=>{
   if(!started||submitted||seconds<=0)return;
   const timer=setInterval(()=>setSeconds(x=>x-1),1000);
   return()=>clearInterval(timer);
 },[started,submitted,seconds]);

 React.useEffect(()=>{
   if(started&&!submitted&&seconds===0){
     setSubmitted(true);
   }
 },[seconds,started,submitted]);

 if(!started){
   return (
    <div className="exam-page">
     <section className="exam-hero">
      <div>
       <span className="kicker">EXAM MODE • MOCK TEST</span>
       <h2>নিজের পরীক্ষা নাও</h2>
       <p>Random MCQ দিয়ে timed test তৈরি করো এবং শেষে performance দেখো।</p>
      </div>
      <div className="exam-icon">⌁</div>
     </section>

     <section className="exam-setup">
      <h3>Test Setup</h3>

      <div className="exam-options">
       <label>
        <span>Chapter</span>
        <select value={scope} onChange={e=>setScope(e.target.value)}>
         <option value="all">সব Chapter</option>
         {chapters.map(c=>
          <option key={c.id} value={c.id}>
           Chapter {c.no} — {c.title}
          </option>
         )}
        </select>
       </label>

       <label>
        <span>Questions</span>
        <select value={size} onChange={e=>setSize(e.target.value)}>
         <option value="10">10 Questions</option>
         <option value="20">20 Questions</option>
         <option value="30">30 Questions</option>
         <option value="50">50 Questions</option>
        </select>
       </label>

       <label>
        <span>Time</span>
        <select value={timeLimit} onChange={e=>setTimeLimit(e.target.value)}>
         <option value="10">10 Minutes</option>
         <option value="20">20 Minutes</option>
         <option value="30">30 Minutes</option>
         <option value="60">60 Minutes</option>
        </select>
       </label>
      </div>

      <button className="exam-start" onClick={buildExam}>
       Start Exam →
      </button>
     </section>

     <section className="exam-rules">
      <div><b>01</b><span>প্রতিটি প্রশ্নের একটি answer select করো</span></div>
      <div><b>02</b><span>সময় শেষ হলে test automatically submit হবে</span></div>
      <div><b>03</b><span>Submit-এর পরে score ও ভুল প্রশ্ন দেখা যাবে</span></div>
     </section>
    </div>
   )
 }

 const correct=examQuestions.filter(q=>{
   const answer=answers[q.id];
   const expected=String(q.answer||'').trim().toLowerCase();
   const selected=String(answer||'').trim().toLowerCase();
   return expected&&selected&&(
     selected===expected ||
     selected.startsWith(expected+')') ||
     expected.startsWith(selected+')')
   );
 }).length;

 const answered=Object.keys(answers).length;
 const score=correct;
 const percentage=examQuestions.length
   ? Math.round(correct/examQuestions.length*100)
   : 0;

 if(submitted){
   return (
    <div className="exam-page">
     <section className="result-card">
      <span className="kicker">TEST COMPLETE</span>
      <h2>পরীক্ষা শেষ</h2>

      <div className="score-circle">
       <b>{percentage}%</b>
       <span>Score</span>
      </div>

      <div className="result-grid">
       <div><b>{score}</b><span>Correct</span></div>
       <div><b>{examQuestions.length-score}</b><span>Wrong</span></div>
       <div><b>{examQuestions.length-answered}</b><span>Unanswered</span></div>
       <div><b>{examQuestions.length}</b><span>Total</span></div>
      </div>

      <div className="result-actions">
       <button onClick={()=>setStarted(false)}>New Test</button>
       <button onClick={()=>{setSubmitted(false);setCurrent(0)}}>Review Answers</button>
      </div>
     </section>

     <section className="review-list">
      <h3>Question Review</h3>

      {examQuestions.map((q,i)=>{
       const selected=answers[q.id];
       const expected=q.answer;
       const isCorrect=String(selected||'').trim().toLowerCase()===
                        String(expected||'').trim().toLowerCase();

       return (
        <article className={`review-item ${isCorrect?'review-correct':'review-wrong'}`} key={q.id}>
         <div className="review-number">Q{i+1}</div>
         <div className="review-body">
          <b>{q.q}</b>
          <p>Your answer: {selected||'Not answered'}</p>
          <p>Correct answer: {expected||'Source answer unavailable'}</p>
         </div>
         <strong>{isCorrect?'✓':'✕'}</strong>
        </article>
       )
      })}
     </section>
    </div>
   )
 }

 const q=examQuestions[current];
 const options=q.options||[];

 const mins=Math.floor(seconds/60).toString().padStart(2,'0');
 const secs=(seconds%60).toString().padStart(2,'0');
 const progress=Math.round(((current+1)/examQuestions.length)*100);

 return (
  <div className="exam-page">
   <section className="exam-running-head">
    <div>
     <span>QUESTION {current+1} / {examQuestions.length}</span>
     <div className="exam-progress">
      <div style={{width:`${progress}%`}}></div>
     </div>
    </div>

    <div className={`exam-timer ${seconds<=60?'timer-danger':''}`}>
     ⏱ {mins}:{secs}
    </div>
   </section>

   <section className="exam-question">
    <div className="exam-q-meta">
     <span>{q.year||'Practice'}</span>
     <span>{q.concept||'Physics'}</span>
    </div>

    <h2>{q.q}</h2>

    <div className="exam-options-list">
     {options.map((option,i)=>{
       const letter=String.fromCharCode(0x0995+i);
       const selected=answers[q.id]===option;

       return (
        <button
         key={i}
         className={selected?'exam-option selected':'exam-option'}
         onClick={()=>choose(option)}
        >
         <span>{letter})</span>
         <b>{option}</b>
        </button>
       )
     })}
    </div>
   </section>

   <section className="exam-navigation">
    <button
     disabled={current===0}
     onClick={()=>setCurrent(Math.max(0,current-1))}
    >
     ← Previous
    </button>

    {current<examQuestions.length-1 ? (
     <button
      className="exam-next"
      onClick={()=>setCurrent(current+1)}
     >
      Next →
     </button>
    ):(
     <button className="exam-submit" onClick={submit}>
      Submit Test
     </button>
    )}
   </section>

   <div className="exam-answer-status">
    Answered {answered} / {examQuestions.length}
   </div>
  </div>
 )
}


createRoot(document.getElementById('root')).render(<App/>);
