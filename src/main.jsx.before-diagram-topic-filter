          ))}
        </div>

      </div>

    </section>
  );
}

function DiagramSVG({type,values,concept}) {

  const v = values || {};

  const W = 900;
  const H = 500;

  const clamp = (x,a,b) =>
    Math.max(a,Math.min(b,Number(x)||0));

  const Grid = () => (
    <>
      <defs>
        <pattern
          id="liveGrid"
          width="45"
          height="45"
          patternUnits="userSpaceOnUse"
        >
          <path
            d="M45 0H0V45"
            fill="none"
            stroke="#141c24"
            strokeWidth="1"
          />
        </pattern>

        <linearGradient id="metalReal" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stopColor="#f8fbfd"/>
          <stop offset="45%" stopColor="#bdc8d1"/>
          <stop offset="100%" stopColor="#6b7680"/>
        </linearGradient>

        <linearGradient id="objectBlue" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0%" stopColor="#dff7ff"/>
          <stop offset="100%" stopColor="#5bc0eb"/>
        </linearGradient>

        <filter id="physicsShadow">
          <feDropShadow
            dx="0"
            dy="10"
            stdDeviation="9"
            floodColor="#000"
            floodOpacity=".55"
          />
        </filter>
      </defs>

      <rect width={W} height={H} fill="#05070a"/>
      <rect
        x="20"
        y="20"
        width={W-40}
        height={H-40}
        rx="18"
        fill="url(#liveGrid)"
      />

      <text
        x="52"
        y="62"
        fill="#6ee7f5"
        fontSize="13"
        fontWeight="800"
        letterSpacing="3"
      >
        PHYSICS LAB
      </text>

      <text
        x="52"
        y="92"
        fill="#f3f7fa"
        fontSize="23"
        fontWeight="800"
      >
        {concept?.title || "Physics Diagram"}
      </text>
    </>
  );

  if (type === "measurement") {
    const L = clamp(v.length,10,200);
    const objectX = 130 + (L/200)*580;

    return (
      <svg viewBox={`0 0 ${W} ${H}`} className="diagram-svg">

        <Grid/>

        <g filter="url(#physicsShadow)">
          <rect
            x="90"
            y="250"
            width="720"
            height="72"
            rx="10"
            fill="url(#metalReal)"
            stroke="#ffffff"
            strokeWidth="2"
          />

          {Array.from({length:73},(_,i)=>{
            const x = 100 + i*9.7;
            const major = i % 10 === 0;
            const mid = i % 5 === 0;

            return (
              <g key={i}>
                <line
                  x1={x}
                  y1="260"
                  x2={x}
                  y2={major ? "306" : mid ? "296" : "286"}
                  stroke="#171d23"
                  strokeWidth={major ? 2 : 1}
                />

                {major && (
                  <text
                    x={x}
                    y="339"
                    textAnchor="middle"
                    fill="#11171d"
                    fontSize="12"
                    fontWeight="700"
                  >
                    {i}
                  </text>
                )}
              </g>
            );
          })}
        </g>

        <rect
          x={objectX}
          y="150"
          width="95"
          height="76"
          rx="14"
          fill="url(#objectBlue)"
          stroke="#ffffff"
          strokeWidth="2"
          filter="url(#physicsShadow)"
        />

        <circle
          cx={objectX+48}
          cy="188"
          r="17"
          fill="#10202c"
        />

        <text
          x={objectX+48}
          y="194"
          textAnchor="middle"
          fill="#67e8f9"
          fontSize="11"
          fontWeight="900"
        >
          OBJ
        </text>

        <line
          x1={objectX+48}
          y1="226"
          x2={objectX+48}
          y2="250"
          stroke="#67e8f9"
          strokeWidth="4"
        />

        <line
          x1="150"
          y1="390"
          x2={objectX+48}
          y2="390"
          stroke="#6ee7b7"
          strokeWidth="4"
        />

        <polygon
          points={`${objectX+48},390 ${objectX+30},380 ${objectX+30},400`}
          fill="#6ee7b7"
        />

        <text
          x="450"
          y="430"
          textAnchor="middle"
          fill="#bffce4"
          fontSize="18"
          fontWeight="800"
        >
          L = {L.toFixed(0)} cm
        </text>

      </svg>
    );
  }

  if (type === "motion") {
    const pos = 100 + (clamp(v.objectDistance,0,200)/200)*610;
    const speed = clamp(v.velocity,0,100);

    return (
      <svg viewBox={`0 0 ${W} ${H}`} className="diagram-svg">

        <Grid/>

        <line
          x1="100"
          y1="345"
          x2="800"
          y2="345"
          stroke="#d7e0e7"
          strokeWidth="6"
        />

        <rect
          x={pos}
          y="274"
          width="100"
          height="70"
          rx="18"
          fill="url(#objectBlue)"
          stroke="#fff"
          strokeWidth="2"
          filter="url(#physicsShadow)"
        />

        <circle cx={pos+25} cy="355" r="16" fill="#111820"/>
        <circle cx={pos+76} cy="355" r="16" fill="#111820"/>

        <line
          x1={pos+105}
          y1="308"
          x2={pos+105+Math.max(60,speed*4)}
          y2="308"
          stroke="#67e8f9"
          strokeWidth="6"
        />

        <polygon
          points={`${pos+105+Math.max(60,speed*4)},308 ${pos+88+Math.max(60,speed*4)},298 ${pos+88+Math.max(60,speed*4)},318`}
          fill="#67e8f9"
        />

        <text
          x="450"
          y="430"
          textAnchor="middle"
          fill="#b9f7ff"
          fontSize="18"
          fontWeight="800"
        >
          Position = {Number(v.objectDistance).toFixed(0)} m
        </text>

      </svg>
    );
  }

  if (type === "force" || type === "momentum") {
    const len = clamp(
      type === "momentum"
        ? Number(v.mass)*Number(v.velocity)
        : v.force,
      10,
      320
    );

    return (
      <svg viewBox={`0 0 ${W} ${H}`} className="diagram-svg">

        <Grid/>

        <rect
          x="320"
          y="260"
          width="170"
          height="110"
          rx="18"
          fill="url(#metalReal)"
          stroke="#fff"
          strokeWidth="2"
          filter="url(#physicsShadow)"
        />

        <circle cx="350" cy="385" r="18" fill="#161f27"/>
        <circle cx="460" cy="385" r="18" fill="#161f27"/>

        <line
          x1="490"
          y1="315"
          x2={490+len}
          y2="315"
          stroke="#fb7185"
          strokeWidth="8"
        />

        <polygon
          points={`${490+len},315 ${475+len},305 ${475+len},325`}
          fill="#fb7185"
        />

        <line
          x1="320"
          y1="315"
          x2="210"
          y2="315"
          stroke="#60a5fa"
          strokeWidth="8"
        />

        <polygon
          points="210,315 225,305 225,325"
          fill="#60a5fa"
        />

        <text
          x="450"
          y="430"
          textAnchor="middle"
          fill="#ffd1da"
          fontSize="18"
          fontWeight="800"
        >
          {type === "momentum"
            ? `p = ${(Number(v.mass)*Number(v.velocity)).toFixed(0)} kg·m/s`
            : `F = ${Number(v.force).toFixed(0)} N`}
        </text>

      </svg>
    );
  }

  if (type === "energy") {
    const h = clamp(v.height,10,200);
    const ballY = 350 - (h/200)*230;

    return (
      <svg viewBox={`0 0 ${W} ${H}`} className="diagram-svg">

        <Grid/>

        <line
          x1="130"
          y1="390"
          x2="760"
          y2="390"
          stroke="#cfd8df"
          strokeWidth="6"
        />

        <line
          x1="230"
          y1={ballY}
          x2="230"
          y2="390"
          stroke="#65737f"
          strokeDasharray="7 7"
        />

        <circle
          cx="230"
          cy={ballY}
          r="32"
          fill="#67e8f9"
          stroke="#fff"
          strokeWidth="3"
          filter="url(#physicsShadow)"
        />

        <text
          x="500"
          y="170"
          fill="#eef7fb"
          fontSize="18"
          fontWeight="800"
        >
          Potential Energy
        </text>

        <rect
          x="500"
          y="195"
          width="170"
          height="22"
          rx="11"
          fill="#17212a"
        />

        <rect
          x="500"
          y="195"
          width={Math.max(10,Math.min(170,(h/200)*170))}
          height="22"
          rx="11"
          fill="#6ee7b7"
        />

      </svg>
    );
  }

  if (type === "density") {
    const mass = clamp(v.mass,1,50);
    const scale = 45 + (mass/50)*75;

    return (
      <svg viewBox={`0 0 ${W} ${H}`} className="diagram-svg">

        <Grid/>

        <rect
          x={450-scale/2}
          y={270-scale/2}
          width={scale}
          height={scale}
          rx="12"
          fill="url(#objectBlue)"
          stroke="#fff"
          strokeWidth="2"
          filter="url(#physicsShadow)"
        />

        <rect
          x="180"
          y="290"
          width="150"
          height="100"
          rx="10"
          fill="#1b6574"
          stroke="#75d7e6"
          strokeWidth="3"
        />

        <path
          d="M195 340 Q225 320 255 340 T315 340"
          fill="none"
          stroke="#b7f7ff"
          strokeWidth="3"
        />

        <text
          x="255"
          y="425"
          textAnchor="middle"
          fill="#bff9ff"
          fontSize="18"
          fontWeight="800"
        >
          Density = {Number(v.density).toFixed(1)}
        </text>

      </svg>
    );
  }

  if (type === "pressure") {
    const depth = clamp(v.depth,10,150);
    const level = 330 - (depth/150)*180;
    const arrowLen = 50 + depth*1.3;

    return (
      <svg viewBox={`0 0 ${W} ${H}`} className="diagram-svg">

        <Grid/>

        <rect
          x="270"
          y="120"
          width="280"
          height="270"
          rx="18"
          fill="#123746"
          fillOpacity=".7"
          stroke="#6ed9ec"
          strokeWidth="3"
        />

        <rect
          x="274"
          y={level}
          width="272"
          height={390-level}
          fill="#1b94af"
          fillOpacity=".42"
        />

        {Array.from({length:5},(_,i)=>{
          const y = 175 + i*38;

          return (
            <line
              key={i}
              x1="410"
              y1={y}
              x2={410+arrowLen*(i/4+.3)}
              y2={y}
              stroke="#fb7185"
              strokeWidth="4"
            />
          );
        })}

        <text
          x="410"
          y="430"
          textAnchor="middle"
          fill="#d0fbff"
          fontSize="18"
          fontWeight="800"
        >
          Pressure increases with depth
        </text>

      </svg>
    );
  }

  if (type === "wave" || type === "sound") {
    const amp = clamp(v.amplitude,10,90);
    const freq = clamp(v.frequency,1,10);

    const pts = Array.from({length:501},(_,i)=>{
      const x = 70+i*1.5;
      const y = 260 - Math.sin(i/(16-freq*.4))*amp;
      return `${i===0?"M":"L"} ${x} ${y}`;
    }).join(" ");

    return (
      <svg viewBox={`0 0 ${W} ${H}`} className="diagram-svg">

        <Grid/>

        <line
          x1="70"
          y1="260"
          x2="830"
          y2="260"
          stroke="#6f7b86"
          strokeWidth="2"
        />

        <path
          d={pts}
          fill="none"
          stroke="#67e8f9"
          strokeWidth="5"
        />

        {type === "sound" && (
          <>
            {Array.from({length:12},(_,i)=>(
              <circle
                key={i}
                cx={100+i*55}
                cy={375}
                r={8+(i%3)*2}
                fill="#dce7ed"
              />
            ))}
          </>
        )}

        <text
          x="450"
          y="430"
          textAnchor="middle"
          fill="#bff8ff"
          fontSize="18"
          fontWeight="800"
        >
          A = {Number(v.amplitude).toFixed(0)} • f = {Number(v.frequency).toFixed(0)} Hz
        </text>

      </svg>
    );
  }

  if (type === "reflection") {
    const a = clamp(v.angle,5,75);
    const rad = a*Math.PI/180;
    const dx = Math.cos(rad)*230;
    const dy = Math.sin(rad)*230;

    return (
      <svg viewBox={`0 0 ${W} ${H}`} className="diagram-svg">

        <Grid/>

        <line
          x1="450"
          y1="130"
          x2="450"
          y2="420"
          stroke="#dce6ec"
          strokeWidth="8"
        />

        <line
          x1="220"
          y1={300-dy}
          x2="450"
          y2="300"
          stroke="#60a5fa"
          strokeWidth="5"
        />

        <line
          x1="450"
          y1="300"
          x2={450+dx}
          y2={300-dy}
          stroke="#fb7185"
          strokeWidth="5"
        />

        <line
          x1="210"
          y1="300"
          x2="690"
          y2="300"
          stroke="#8997a3"
          strokeDasharray="10 10"
        />

        <text
          x="450"
          y="455"
          textAnchor="middle"
          fill="#d9ecf5"
          fontSize="18"
          fontWeight="800"
        >
          Angle of incidence = angle of reflection = {a}°
        </text>

      </svg>
    );
  }

  if (type === "refraction") {
    const a = clamp(v.angle,5,75);
    const rad = a*Math.PI/180;

    const dx1 = Math.cos(rad)*180;
    const dy1 = Math.sin(rad)*180;

    const dx2 = Math.cos(rad*.68)*190;
    const dy2 = Math.sin(rad*.68)*190;

    return (
      <svg viewBox={`0 0 ${W} ${H}`} className="diagram-svg">

        <Grid/>

        <rect
          x="60"
          y="90"
          width="780"
          height="205"
          fill="#10212e"
        />

        <rect
          x="60"
          y="295"
          width="780"
          height="145"
          fill="#173946"
        />

        <line
          x1="60"
          y1="295"
          x2="840"
          y2="295"
          stroke="#9ceaf4"
          strokeWidth="3"
        />

        <line
          x1={450-dx1}
          y1={295-dy1}
          x2="450"
          y2="295"
          stroke="#60a5fa"
          strokeWidth="5"
        />

        <line
          x1="450"
          y1="295"
          x2={450+dx2}
          y2={295+dy2}
          stroke="#fb7185"
          strokeWidth="5"
        />

        <text
          x="450"
          y="465"
          textAnchor="middle"
          fill="#d8f8ff"
          fontSize="18"
          fontWeight="800"
        >
          Live refraction — θ = {a}°
        </text>

      </svg>
    );
  }

  if (type === "lens") {
    const f = clamp(v.focalLength,20,100);
    const obj = clamp(v.objectDistance,40,180);

    const lensX = 450;
    const objectX = lensX - obj*2.1;

    const imageDist = (f*obj)/(Math.max(1,obj-f));
    const imageX = lensX + Math.min(210,imageDist*1.5);

    return (
      <svg viewBox={`0 0 ${W} ${H}`} className="diagram-svg">

        <Grid/>

        <path
          d="M450 110 C415 155 415 395 450 440 C485 395 485 155 450 110"
          fill="#75d7ee"
          fillOpacity=".18"
          stroke="#a8f2ff"
          strokeWidth="4"
        />

        <circle cx={lensX-f*2.2} cy="300" r="7" fill="#60a5fa"/>
        <circle cx={lensX+f*2.2} cy="300" r="7" fill="#fb7185"/>

        <line
          x1={objectX}
          y1="260"
          x2={objectX}
          y2="340"
          stroke="#f8fafc"
          strokeWidth="9"
        />

        <line
          x1={objectX}
          y1="260"
          x2={lensX}
          y2="300"
          stroke="#60a5fa"
          strokeWidth="3"
        />

        <line
          x1={lensX}
          y1="300"
          x2={imageX}
          y2="340"
          stroke="#fb7185"
          strokeWidth="3"
        />

        <line
          x1={objectX}
          y1="260"
          x2={lensX}
          y2="260"
          stroke="#60a5fa"
