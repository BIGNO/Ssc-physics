import React from "react";

function getType(c = {}) {
  const t = [
    c.title, c.definition, c.simpleExplanation,
    c.detailedExplanation, c.formula, c.examFocus
  ].filter(Boolean).join(" ").toLowerCase();

  if (/পরিমাপ|ভৌত রাশি|একক|মাত্রা|ত্রুটি|measurement|unit/.test(t)) return "measurement";
  if (/গতি|বেগ|ত্বরণ|দূরত্ব.*সময়|velocity|acceleration|motion/.test(t)) return "motion";
  if (/তরঙ্গ|কম্পন|তরঙ্গদৈর্ঘ্য|frequency|wave/.test(t)) return "wave";
  if (/বল|ঘর্ষণ|নিউটনের|force|friction|newton/.test(t)) return "force";
  if (/কাজ|শক্তি|ক্ষমতা|kinetic|potential|energy|power/.test(t)) return "energy";
  if (/ঘনত্ব|density|ভর.*আয়তন|mass.*volume/.test(t)) return "density";
  if (/চাপ|pressure/.test(t)) return "pressure";
  if (/দর্পণ|প্রতিফলন|mirror|reflection/.test(t)) return "reflection";
  if (/লেন্স|প্রতিসরণ|lens|refraction/.test(t)) return "refraction";
  if (/বিদ্যুৎ|বর্তনী|রোধ|ওহম|current|voltage|resistance|circuit|ohm/.test(t)) return "circuit";
  if (/চৌম্বক|magnetic|magnet/.test(t)) return "magnetism";
  if (/মোটর|motor/.test(t)) return "motor";
  if (/জেনারেটর|generator/.test(t)) return "generator";
  if (/ট্রান্সফরমার|transformer/.test(t)) return "transformer";
  if (/তাপ|তাপমাত্রা|heat|temperature/.test(t)) return "heat";
  if (/পরমাণু|নিউক্লিয়াস|electron|atom|nucleus/.test(t)) return "atom";

  return "science";
}

