export default function TopicMicroDemo({concept}) {
  const type = getType(concept);

  return (
    <aside className="topic-micro-demo">
      <div className="tm-head">
        <span>VISUAL DEMO</span>
        <b>3.8s LOOP</b>
      </div>

      <div className="tm-stage">
        <Visual type={type}/>
      </div>

      <div className="tm-foot">
        <span>{concept?.title || "Physics concept"}</span>
        <small>Hover to pause</small>
      </div>
    </aside>
  );
}
