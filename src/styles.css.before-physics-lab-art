/* =========================================================
   PHASE 1 — MODERN UI FOUNDATION
   ========================================================= */

*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{margin:0;min-width:320px;background:#f4f6fb;color:var(--text)}
button,input,select{font:inherit}
button{transition:transform .16s ease,box-shadow .16s ease,background .16s ease,border-color .16s ease}
button:active{transform:translateY(1px)}

.topbar{
  height:78px;
  padding:0 32px;
  background:rgba(255,255,255,.94);
  backdrop-filter:blur(14px);
  border-bottom:1px solid rgba(221,227,237,.9);
  box-shadow:0 3px 18px rgba(30,45,75,.035);
}

.brand{gap:13px}
.logo{
  width:44px;height:44px;border-radius:14px;
  background:linear-gradient(135deg,#111b31,#2a3653);
  box-shadow:0 7px 18px rgba(16,26,46,.16);
}
.brand b{font-size:18px;letter-spacing:-.02em}
.brand span{font-size:11px;letter-spacing:.02em}

.header-right{gap:10px}
.progress-chip{
  background:#f7f8ff;
  border-color:#e2e1fb;
  padding:10px 14px;
}
.progress-chip b{color:var(--primary)}

.search{
  height:43px;
  width:300px;
  background:#f9faff;
  border-color:#e0e5ef;
  transition:border-color .2s,box-shadow .2s,background .2s;
}
.search:focus-within{
  background:#fff;
  border-color:#a9a2ff;
  box-shadow:0 0 0 4px rgba(101,86,245,.08);
}
.search span{color:#8994a8;font-size:20px}

.dark-btn,.primary-btn,.done-btn{
  box-shadow:0 6px 14px rgba(20,30,55,.08);
}
.dark-btn:hover{background:#1b2740;box-shadow:0 8px 18px rgba(20,30,55,.14)}
.primary-btn{background:var(--primary)}
.primary-btn:hover{background:var(--primary-dark);box-shadow:0 8px 18px rgba(101,86,245,.22)}
.done-btn{box-shadow:none}

.layout{grid-template-columns:300px minmax(0,1fr)}

.sidebar{
  background:linear-gradient(180deg,#f8f9fd 0%,#f4f6fb 100%);
  border-right:1px solid var(--border);
  padding:25px 16px;
}

.side-label{
  margin:8px 10px 11px;
  color:#98a2b4;
  font-size:10px;
}

.subject-card{
  background:linear-gradient(135deg,#eeedff,#e7e5ff);
  border:1px solid #dedbff;
  box-shadow:0 8px 22px rgba(101,86,245,.07);
}

.chapter{
  position:relative;
  border:1px solid transparent;
  transition:all .18s ease;
}
.chapter:hover{
  background:#fff;
  border-color:#e1e5ef;
  box-shadow:0 5px 15px rgba(30,45,75,.045);
}
.chapter.active{
  background:linear-gradient(135deg,#101a2e,#182640);
  border-color:#101a2e;
  box-shadow:0 8px 18px rgba(16,26,46,.16);
}

.sidebar-foot{
  border-top:1px solid #e3e7ef;
  margin-top:24px;
  padding-top:17px;
}

.main{
  padding:34px clamp(20px,4vw,52px) 70px;
  max-width:1550px;
}

.hero{
  min-height:130px;
  padding:25px 27px;
  margin-bottom:18px;
  border:1px solid var(--border);
  border-radius:22px;
  background:
    radial-gradient(circle at 90% 10%,rgba(101,86,245,.12),transparent 28%),
    linear-gradient(135deg,#fff,#f9faff);
  box-shadow:var(--shadow);
}

.hero h1{
  font-size:40px;
  letter-spacing:-.035em;
  color:#111a2d;
}

.hero p{max-width:760px;line-height:1.65}

.tabs{
  background:#fff;
  border:1px solid var(--border);
  border-radius:14px;
  padding:4px;
  gap:2px;
  margin-bottom:22px;
  box-shadow:0 5px 18px rgba(30,45,75,.035);
}
.tabs button{
  border-radius:10px;
  border-bottom:0;
  padding:11px 17px;
}
.tabs button:hover{background:#f4f5fb}
.tabs button.active{
  color:#fff;
  background:var(--navy);
  border-color:transparent;
}

.panel{
  border-color:var(--border);
  border-radius:20px;
  box-shadow:var(--shadow);
}

.panel-head h2{letter-spacing:-.02em}

.badge{
  background:#f0efff;
  border:1px solid #e3e0ff;
}

.manual-list>label,
.manual-list>div{
  display:grid;
  grid-template-columns:28px 1fr 18px;
  gap:10px;
  align-items:start;
  border:1px solid #e5e9f1;
  padding:12px;
  border-radius:13px;
  background:#fbfcff;
  transition:.18s ease;
}
.manual-list>label:hover,
.manual-list>div:hover{
  background:#fff;
  border-color:#d7dced;
  box-shadow:0 5px 15px rgba(30,45,75,.045);
}
.manual-list label input{margin-top:6px;accent-color:var(--primary)}

.concept-card{
  padding:22px 8px;
}
.concept-card:hover{background:#fcfdff}
.concept-index{
  width:36px;height:30px;
  display:grid;place-items:center;
  background:#f1f2ff;
  border-radius:9px;
  color:var(--primary);
}
.concept-body h3{
  font-size:19px;
  letter-spacing:-.015em;
}
.concept-section{
  margin-top:13px;
  padding-left:2px;
}
.concept-section>b{
  display:inline-block;
  margin-bottom:4px;
  font-size:12px;
  color:#515d73;
}
.concept-section p{font-size:14px}

.formula{
  background:linear-gradient(135deg,#f6f5ff,#fafaff);
  border:1px solid #e6e3ff;
}
.formula code{
  color:#4339b9;
  font-weight:700;
}

.qcard{
  border-color:var(--border);
  box-shadow:0 5px 18px rgba(30,45,75,.035);
  transition:.18s ease;
}
.qcard:hover{
  transform:translateY(-2px);
  box-shadow:0 10px 25px rgba(30,45,75,.07);
}
.qmeta span{border:1px solid #e6e9f0}

.practice-banner,.ai-banner{
  background:
    radial-gradient(circle at 90% 0%,rgba(101,86,245,.25),transparent 30%),
    linear-gradient(135deg,#0d172a,#18243c);
  box-shadow:0 12px 30px rgba(16,26,46,.12);
}

.diagram-stage{
  border:1px solid #e1e6ef;
  background:
    linear-gradient(rgba(80,95,125,.045) 1px,transparent 1px),
    linear-gradient(90deg,rgba(80,95,125,.045) 1px,transparent 1px),
    #f9fbff;
  background-size:24px 24px;
}

.controls input:focus,
.chatbar input:focus{
  border-color:#aaa4ff;
  box-shadow:0 0 0 4px rgba(101,86,245,.08);
}

.note-box{
  border-radius:16px;
  box-shadow:0 5px 18px rgba(30,45,75,.035);
}

@media(max-width:1100px){
  .layout{grid-template-columns:250px}
  .main{padding:26px 20px 60px}
  .topbar{padding:0 18px}
}

@media(max-width:760px){
  .topbar{
    padding:12px 14px;
    border-radius:0;
  }
  .brand b{font-size:16px}
  .header-right{gap:7px}
  .dark-btn{padding:10px 12px;font-size:12px}
  .layout{display:block}
  .sidebar{
    position:static;
    height:auto;
    min-height:0;
    padding:14px;
  }
  .chapter-list{grid-template-columns:1fr 1fr}
  .main{padding:18px 12px 50px}
  .hero{
    padding:20px;
    border-radius:18px;
  }
  .hero h1{font-size:30px}
  .tabs{
    overflow:auto;
    white-space:nowrap;
  }
  .tabs button{flex:0 0 auto}
}

@media(max-width:520px){
  .chapter-list{grid-template-columns:1fr}
  .search{width:auto;min-width:0}
  .hero h1{font-size:27px}
  .controls{grid-template-columns:1fr}
}

/* =========================================================
   DASHBOARD — PHASE 1 STEP 2
   ========================================================= */

.dashboard{
  display:grid;
  gap:18px;
}

.dashboard-hero{
  min-height:220px;
  padding:30px 34px;
  border-radius:24px;
  color:#fff;
  display:flex;
  justify-content:space-between;
  align-items:center;
  gap:25px;
  overflow:hidden;
  background:
    radial-gradient(circle at 85% 20%,rgba(101,86,245,.35),transparent 30%),
    radial-gradient(circle at 65% 100%,rgba(79,70,229,.20),transparent 35%),
    linear-gradient(135deg,#0c1629,#192640);
  box-shadow:0 16px 38px rgba(16,26,46,.15);
}

.dashboard-hero .eyebrow{
  color:#a9a2ff;
}

.dashboard-hero h1{
  margin:9px 0 8px;
  max-width:720px;
  font-size:38px;
  line-height:1.12;
  letter-spacing:-.035em;
}

.dashboard-hero p{
  max-width:700px;
  margin:0;
  color:#bdc6d6;
  line-height:1.7;
}

.dashboard-progress{
  flex:0 0 auto;
}

.progress-ring{
  width:130px;
  height:130px;
  border-radius:50%;
  display:flex;
  flex-direction:column;
  align-items:center;
  justify-content:center;
  border:10px solid rgba(255,255,255,.13);
  box-shadow:inset 0 0 0 1px rgba(255,255,255,.08);
  background:rgba(255,255,255,.045);
}

.progress-ring strong{
  font-size:27px;
  line-height:1;
}

.progress-ring span{
  margin-top:7px;
  font-size:11px;
  color:#c5ccda;
  font-weight:800;
}

.stats-grid{
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:14px;
}

.stat-card{
  min-height:100px;
  display:flex;
  align-items:center;
  gap:13px;
  padding:18px;
  background:#fff;
  border:1px solid var(--border);
  border-radius:17px;
  box-shadow:var(--shadow);
}

.stat-icon{
  width:42px;
  height:42px;
  border-radius:12px;
  display:grid;
  place-items:center;
  background:#f0efff;
  color:var(--primary);
  font-size:13px;
  font-weight:900;
}

.stat-card strong{
  display:block;
  font-size:24px;
  letter-spacing:-.02em;
}

.stat-card div span{
  display:block;
  margin-top:2px;
  color:#8490a5;
  font-size:11px;
  font-weight:700;
}

.dashboard-grid{
  display:grid;
  grid-template-columns:1.35fr 1fr;
  gap:18px;
}

.continue-content{
  display:flex;
  gap:18px;
  align-items:flex-start;
}

.continue-number{
  width:62px;
  height:62px;
  flex:0 0 auto;
  display:grid;
  place-items:center;
  border-radius:17px;
  background:#111b31;
  color:#fff;
  font-size:18px;
  font-weight:900;
}

.continue-info>span{
  color:#8994a8;
  font-size:11px;
  font-weight:800;
}

.continue-info h3{
  margin:4px 0 5px;
  font-size:22px;
}

.continue-info p{
  margin:0 0 15px;
  color:#68758c;
  line-height:1.55;
  font-size:13px;
}

.quick-grid{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:10px;
}

.quick-grid button{
  min-height:88px;
  padding:14px;
  text-align:left;
  cursor:pointer;
  background:#fafbff;
  border:1px solid #e4e8f0;
  border-radius:13px;
}

.quick-grid button:hover{
  background:#fff;
  border-color:#cfcafc;
  box-shadow:0 7px 18px rgba(30,45,75,.06);
  transform:translateY(-2px);
}

.quick-grid b{
  display:block;
  color:#202c43;
  font-size:14px;
}

.quick-grid span{
  display:block;
  margin-top:5px;
  color:#8994a8;
  font-size:11px;
  line-height:1.4;
}

.dashboard-chapters{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:9px;
}

.dashboard-chapter{
  width:100%;
  min-height:70px;
  display:grid;
  grid-template-columns:42px 1fr 25px;
  align-items:center;
  gap:10px;
  padding:11px;
  text-align:left;
  cursor:pointer;
  background:#fafbfe;
