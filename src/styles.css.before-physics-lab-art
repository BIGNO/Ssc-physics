/* ==========================
   STEP 6 — EXAM MODE
   ========================== */

.exam-page{
  display:flex;
  flex-direction:column;
  gap:18px;
}

.exam-hero{
  display:flex;
  justify-content:space-between;
  align-items:center;
  padding:30px;
  border-radius:22px;
  background:linear-gradient(135deg,#111c31,#203958);
  color:#fff;
}

.exam-hero h2{
  margin:7px 0;
  font-size:30px;
}

.exam-hero p{
  margin:0;
  opacity:.78;
}

.exam-icon{
  font-size:60px;
  opacity:.6;
}

.exam-setup{
  background:#fff;
  border:1px solid #e3e8ef;
  border-radius:18px;
  padding:24px;
}

.exam-setup h3{
  margin:0 0 18px;
}

.exam-options{
  display:grid;
  grid-template-columns:2fr 1fr 1fr;
  gap:12px;
}

.exam-options label{
  display:flex;
  flex-direction:column;
  gap:7px;
}

.exam-options label span{
  font-size:12px;
  font-weight:700;
  color:#647187;
}

.exam-options select{
  padding:12px;
  border:1px solid #d9e0e9;
  border-radius:10px;
  background:#fff;
}

.exam-start{
  margin-top:18px;
  border:0;
  border-radius:11px;
  background:#15253c;
  color:#fff;
  padding:12px 19px;
  cursor:pointer;
  font-weight:800;
}

.exam-rules{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:12px;
}

.exam-rules>div{
  display:flex;
  align-items:center;
  gap:12px;
  background:#fff;
  border:1px solid #e4e8ee;
  border-radius:14px;
  padding:15px;
}

.exam-rules b{
  width:32px;
  height:32px;
  display:grid;
  place-items:center;
  border-radius:9px;
  background:#eef2f7;
  font-size:12px;
}

.exam-rules span{
  font-size:13px;
  color:#58667b;
}

.exam-running-head{
  display:flex;
  justify-content:space-between;
  align-items:center;
  background:#fff;
  border:1px solid #e3e8ef;
  border-radius:15px;
  padding:15px 18px;
}

.exam-running-head>div:first-child{
  width:60%;
}

.exam-running-head span{
  font-size:12px;
  font-weight:800;
  color:#65738a;
}

.exam-progress{
  height:6px;
  background:#e9edf2;
  border-radius:10px;
  overflow:hidden;
  margin-top:8px;
}

.exam-progress>div{
  height:100%;
  background:#334d6b;
  transition:.2s;
}

.exam-timer{
  font-size:20px;
  font-weight:900;
  letter-spacing:1px;
}

.timer-danger{
  color:#b44444;
}

.exam-question{
  background:#fff;
  border:1px solid #e3e8ef;
  border-radius:19px;
  padding:25px;
}

.exam-q-meta{
  display:flex;
  gap:8px;
  flex-wrap:wrap;
}

.exam-q-meta span{
  font-size:11px;
  background:#f1f4f8;
  padding:6px 9px;
  border-radius:7px;
  color:#66748a;
}

.exam-question h2{
  font-size:20px;
  line-height:1.6;
  margin:18px 0 22px;
}

.exam-options-list{
  display:flex;
  flex-direction:column;
  gap:10px;
}

.exam-option{
  display:flex;
  align-items:center;
  gap:13px;
  text-align:left;
  padding:14px;
  border:1px solid #dfe5ed;
  background:#fff;
  border-radius:12px;
  cursor:pointer;
  transition:.15s;
}

.exam-option:hover{
  border-color:#8797aa;
}

.exam-option.selected{
  border-color:#405977;
  background:#f0f4f8;
}

.exam-option>span{
  width:28px;
  height:28px;
  display:grid;
  place-items:center;
  border-radius:8px;
  background:#edf1f5;
  font-weight:800;
}

.exam-navigation{
  display:flex;
  justify-content:space-between;
  gap:10px;
}

.exam-navigation button,
.result-actions button{
  border:1px solid #d8dfe8;
  background:#fff;
  padding:11px 16px;
  border-radius:10px;
  cursor:pointer;
  font-weight:700;
}

.exam-navigation button:disabled{
  opacity:.4;
  cursor:not-allowed;
}

.exam-navigation .exam-next,
.exam-navigation .exam-submit{
  background:#15253c;
  color:#fff;
  border-color:#15253c;
}

.exam-answer-status{
  text-align:center;
  color:#758196;
  font-size:12px;
}

.result-card{
  background:#fff;
  border:1px solid #e1e7ee;
  border-radius:22px;
  padding:30px;
  text-align:center;
}

.result-card h2{
  margin:8px 0 20px;
}

.score-circle{
  width:135px;
  height:135px;
  border:8px solid #dfe6ee;
  border-radius:50%;
  display:flex;
  flex-direction:column;
  justify-content:center;
  align-items:center;
  margin:0 auto 25px;
}

.score-circle b{
  font-size:30px;
}

.score-circle span{
  font-size:12px;
  color:#748095;
}

.result-grid{
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:10px;
}

.result-grid>div{
  background:#f7f9fb;
  padding:15px;
  border-radius:12px;
}

.result-grid b{
  display:block;
  font-size:22px;
}

.result-grid span{
  font-size:11px;
  color:#748095;
}

.result-actions{
  display:flex;
  justify-content:center;
  gap:10px;
  margin-top:22px;
}

.result-actions button:first-child{
  background:#15253c;
  color:#fff;
}

.review-list{
  display:flex;
  flex-direction:column;
  gap:10px;
}

.review-list h3{
  margin:0;
}

.review-item{
  display:flex;
  align-items:flex-start;
  gap:12px;
  padding:15px;
  background:#fff;
  border:1px solid #e3e8ef;
  border-radius:13px;
}

.review-number{
  font-weight:900;
  min-width:35px;
}

.review-body{
  flex:1;
}

.review-body b{
  line-height:1.5;
}

.review-body p{
  margin:7px 0 0;
  font-size:12px;
  color:#68758a;
}

.review-item>strong{
  font-size:20px;
}

.review-correct{
  border-left:4px solid #6b8b72;
}

.review-wrong{
  border-left:4px solid #a86a6a;
}

@media(max-width:800px){
  .exam-options,
  .exam-rules{
    grid-template-columns:1fr;
  }

  .result-grid{
    grid-template-columns:1fr 1fr;
  }

  .exam-running-head>div:first-child{
    width:52%;
  }
}

@media(max-width:520px){
  .exam-hero{
    padding:22px;
  }

  .exam-icon{
    display:none;
  }

  .exam-question{
    padding:18px;
  }

  .exam-question h2{
    font-size:17px;
  }

  .result-actions{
    flex-direction:column;
  }
}



/* STEP 8 — Progress System */

.study-actions{
  display:flex;
  flex-wrap:wrap;
  gap:8px;
  margin:12px 0;
}

.study-btn{
  border:1px solid #d9dfef;
  background:#fff;
  color:#26324a;
  border-radius:10px;
  padding:8px 11px;
  cursor:pointer;
  font-weight:700;
}

.study-btn:hover{
  transform:translateY(-1px);
}

.study-btn.active{
  background:#eef0ff;
  border-color:#6256f2;
  color:#5043d8;
}

.progress-top-btn{
  margin-left:8px;
}

.progress-page{
  display:grid;
  gap:18px;
}

.progress-hero{
  display:flex;
  justify-content:space-between;
  align-items:center;
  gap:24px;
  padding:30px;
  border:1px solid #e4e7f3;
  border-radius:24px;
  background:linear-gradient(135deg,#fff,#f5f3ff);
}

.progress-hero h1{
  margin:7px 0 8px;
}

.progress-hero p{
  margin:0;
  color:#68728a;
}

.big-progress{
  min-width:160px;
  text-align:center;
  padding:18px;
  border-radius:18px;
  background:#fff;
  border:1px solid #e2e5f1;
}

.big-progress strong{
  display:block;
  font-size:42px;
}

.big-progress span{
  color:#727b91;
}

.progress-stats{
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:12px;
}

.progress-stat{
  padding:18px;
  border:1px solid #e2e6f0;
  border-radius:16px;
  background:#fff;
}

.progress-stat span{
  display:block;
  color:#74809a;
  font-size:13px;
}

.progress-stat b{
  display:block;
  font-size:28px;
  margin-top:6px;
}

.progress-stat.danger b{
  color:#d24e4e;
}

.chapter-progress-list{
  display:grid;
  gap:13px;
}

.chapter-progress-row{
  display:grid;
  grid-template-columns:minmax(240px,2fr) minmax(120px,1fr) 60px;
  align-items:center;
  gap:14px;
}

.chapter-progress-row small{
  display:block;
  color:#7b8498;
  margin-top:3px;
}

.mini-progress{
  height:9px;
  background:#edf0f7;
  border-radius:99px;
  overflow:hidden;
}

.mini-progress div{
  height:100%;
  background:#6256f2;
  border-radius:99px;
  transition:width .3s ease;
}

.chapter-progress-row>span{
  text-align:right;
  font-weight:800;
}

.progress-list{
  display:grid;
  gap:12px;
}

.progress-item{
  display:flex;
  justify-content:space-between;
  align-items:center;
  gap:18px;
  padding:16px;
  border:1px solid #e2e6ef;
  border-radius:14px;
  background:#fafbfe;
}

.progress-item h3{
  margin:7px 0 0;
}

.progress-item button{
  white-space:nowrap;
  border:0;
  background:#121c32;
  color:#fff;
  border-radius:10px;
  padding:9px 13px;
  cursor:pointer;
  font-weight:700;
}

.item-meta{
  display:flex;
  flex-wrap:wrap;
  gap:7px;
}

.item-meta span{
  font-size:12px;
  padding:4px 7px;
  background:#eef1f7;
  border-radius:7px;
}

@media(max-width:900px){

  .progress-stats{
    grid-template-columns:repeat(2,1fr);
  }

  .progress-hero{
    flex-direction:column;
    align-items:flex-start;
  }

  .chapter-progress-row{
    grid-template-columns:1fr;
  }

  .chapter-progress-row>span{
    text-align:left;
  }

}

@media(max-width:640px){

  .progress-stats{
    grid-template-columns:1fr;
  }

  .progress-item{
    flex-direction:column;
    align-items:flex-start;
  }

  .progress-item button{
    width:100%;
  }

  .progress-top-btn{
    margin-left:0;
  }

}

/* LIVE DIAGRAM SYSTEM V4 */

.live-diagram-stage {
  width: 100%;
  min-height: 420px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 22px;
  padding: 18px;
  overflow: hidden;
}

.diagram-svg {
  width: 100%;
  max-width: 720px;
  height: auto;
  min-height: 260px;
}

.diagram-svg line,
.diagram-svg path,
.diagram-svg rect,
.diagram-svg circle {
  vector-effect: non-scaling-stroke;
}

.diagram-svg text {
  font-family: inherit;
  fill: currentColor;
}

.diagram-object {
  opacity: .9;
}

.diagram-field {
  display: grid;
  gap: 7px;
  margin-bottom: 14px;
}

.diagram-field label {
  font-size: .78rem;
  font-weight: 700;
  opacity: .72;
}

.diagram-field input,
.diagram-field select {
  width: 100%;
  box-sizing: border-box;
  border: 1px solid rgba(127,127,127,.24);
  border-radius: 12px;
  padding: 10px 12px;
  background: rgba(255,255,255,.04);
  color: inherit;
  outline: none;
}

.diagram-field input:focus,
.diagram-field select:focus {
  border-color: currentColor;
}

.diagram-reset {
  width: 100%;
  margin-top: 4px;
}

.live-note {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-top: 12px;
  font-size: .78rem;
  opacity: .74;
}

.diagram-page {
  display: grid;
  gap: 18px;
}

.diagram-layout {
  display: grid;
  grid-template-columns: minmax(250px, 310px) minmax(0, 1fr);
  gap: 18px;
  align-items: stretch;
}

.diagram-controls {
  align-self: start;
}

.diagram-canvas {
  min-width: 0;
  overflow: hidden;
}

.diagram-topics {
  overflow: hidden;
}

.concept-diagram-mini-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0,1fr));
  gap: 14px;
}

.concept-diagram-mini {
  border: 1px solid rgba(127,127,127,.16);
  border-radius: 18px;
  padding: 12px;
  overflow: hidden;
}

.concept-diagram-mini-head {
  display: flex;
  gap: 10px;
  align-items: center;
  margin-bottom: 8px;
}

.concept-diagram-mini-head > span {
  width: 28px;
  height: 28px;
  border-radius: 9px;
  display: grid;
  place-items: center;
  font-size: .72rem;
  font-weight: 800;
  background: rgba(127,127,127,.12);
}

.concept-diagram-mini .diagram-svg {
  min-height: 190px;
}

.concept-live-diagram {
  margin: 14px 0;
  border: 1px solid rgba(127,127,127,.16);
  border-radius: 18px;
  padding: 10px;
  overflow: hidden;
  background: rgba(127,127,127,.04);
}

.concept-live-diagram-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  margin-bottom: 6px;
}

.concept-live-diagram-head span {
  font-size: .68rem;
  letter-spacing: .12em;
  font-weight: 800;
  opacity: .58;
}

.concept-live-diagram-head b {
  font-size: .72rem;
  text-transform: uppercase;
  opacity: .7;
}

.concept-live-diagram .diagram-svg {
  min-height: 220px;
}

.energy-bar {
  opacity: .82;
}

.thermometer {
  opacity: .5;
}

.atom-shell {
  fill: none;
  opacity: .45;
  stroke-dasharray: 8 8;
}

.nucleus {
  opacity: .86;
}

.electron {
  opacity: .9;
}

.field-line {
  opacity: .72;
}

@media (max-width: 900px) {
  .diagram-layout {
    grid-template-columns: 1fr;
  }

  .concept-diagram-mini-grid {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 640px) {
  .live-diagram-stage {
    min-height: 300px;
    padding: 8px;
  }

  .diagram-svg {
    min-height: 220px;
  }

  .concept-live-diagram .diagram-svg,
  .concept-diagram-mini .diagram-svg {
    min-height: 180px;
  }
}
