  }

  if(type === 'magnetic' || type === 'motor' || type === 'generator') {
    return (
      <svg viewBox="0 0 700 400" className="diagram-svg">
        <circle cx="350" cy="205" r="105" fill="none" stroke="currentColor" strokeWidth="4"/>
