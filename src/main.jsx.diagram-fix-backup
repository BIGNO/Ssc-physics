        </text>
      </svg>
    );
  }

  if(type === 'heat') {
    return (
      <svg viewBox="0 0 700 400" className="diagram-svg">
        <rect x="210" y="120" width="280" height="180" rx="10" fill="none" stroke="currentColor" strokeWidth="4"/>
