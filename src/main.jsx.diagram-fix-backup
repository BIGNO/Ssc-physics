        <line
          x1="350"
          y1="210"
          x2={350 + 220*Math.cos(angle*Math.PI/180)}
          y2={210 + 220*Math.sin(angle*Math.PI/180)}
          stroke="currentColor"
          strokeWidth="3"
          strokeDasharray="7 7"
        />
        <text x="360" y="75">{type === 'mirror' ? 'Mirror' : 'Normal / Interface'}</text>
        <text x="105" y="65">Incident ray</text>
        <text x="500" y="90">Ray</text>
        <text x="380" y="245">θ = {angle}°</text>
      </svg>
    );
  }

  if(type === 'pressure') {
    return (
      <svg viewBox="0 0 700 420" className="diagram-svg">
        <path d="M180 80 L180 330 Q350 390 520 330 L520 80" fill="none" stroke="currentColor" strokeWidth="4"/>
        <line x1="185" y1="180" x2="515" y2="180" stroke="currentColor" strokeWidth="3"/>
