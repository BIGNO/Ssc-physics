function ExamMode({chapters,allQuestions}){
 const [started,setStarted]=useState(false);
 const [submitted,setSubmitted]=useState(false);
 const [size,setSize]=useState(20);
 const [scope,setScope]=useState('all');
 const [timeLimit,setTimeLimit]=useState(20);
 const [examQuestions,setExamQuestions]=useState([]);
 const [current,setCurrent]=useState(0);
 const [answers,setAnswers]=useState({});
 const [seconds,setSeconds]=useState(0);

 const buildExam=()=>{
   let pool=allQuestions.filter(q=>{
     const c=q.chapterId||q.chapter;
     return scope==='all'||c===scope;
   }).filter(q=>String(q.type||'').toUpperCase()==='MCQ');

   pool=[...pool].sort(()=>Math.random()-0.5).slice(0,Number(size));

   if(!pool.length){
     alert('এই filter অনুযায়ী MCQ পাওয়া যায়নি।');
     return;
   }

   setExamQuestions(pool);
   setAnswers({});
   setCurrent(0);
   setSubmitted(false);
   setSeconds(Number(timeLimit)*60);
   setStarted(true);
 };

 const choose=(value)=>{
   if(submitted)return;
   const q=examQuestions[current];
   setAnswers({...answers,[q.id]:value});
 };

 const submit=()=>{
   setSubmitted(true);
 };

 React.useEffect(()=>{
   if(!started||submitted||seconds<=0)return;
   const timer=setInterval(()=>setSeconds(x=>x-1),1000);
   return()=>clearInterval(timer);
 },[started,submitted,seconds]);

 React.useEffect(()=>{
   if(started&&!submitted&&seconds===0){
     setSubmitted(true);
   }
 },[seconds,started,submitted]);

 if(!started){
   return (
    <div className="exam-page">
     <section className="exam-hero">
      <div>
       <span className="kicker">EXAM MODE • MOCK TEST</span>
       <h2>নিজের পরীক্ষা নাও</h2>
       <p>Random MCQ দিয়ে timed test তৈরি করো এবং শেষে performance দেখো।</p>
      </div>
      <div className="exam-icon">⌁</div>
     </section>

     <section className="exam-setup">
      <h3>Test Setup</h3>

      <div className="exam-options">
       <label>
        <span>Chapter</span>
        <select value={scope} onChange={e=>setScope(e.target.value)}>
         <option value="all">সব Chapter</option>
         {chapters.map(c=>
          <option key={c.id} value={c.id}>
           Chapter {c.no} — {c.title}
          </option>
         )}
        </select>
       </label>

       <label>
        <span>Questions</span>
        <select value={size} onChange={e=>setSize(e.target.value)}>
         <option value="10">10 Questions</option>
         <option value="20">20 Questions</option>
         <option value="30">30 Questions</option>
         <option value="50">50 Questions</option>
        </select>
       </label>

       <label>
        <span>Time</span>
        <select value={timeLimit} onChange={e=>setTimeLimit(e.target.value)}>
         <option value="10">10 Minutes</option>
         <option value="20">20 Minutes</option>
         <option value="30">30 Minutes</option>
         <option value="60">60 Minutes</option>
        </select>
       </label>
      </div>

      <button className="exam-start" onClick={buildExam}>
       Start Exam →
      </button>
     </section>

     <section className="exam-rules">
      <div><b>01</b><span>প্রতিটি প্রশ্নের একটি answer select করো</span></div>
      <div><b>02</b><span>সময় শেষ হলে test automatically submit হবে</span></div>
      <div><b>03</b><span>Submit-এর পরে score ও ভুল প্রশ্ন দেখা যাবে</span></div>
     </section>
    </div>
   )
 }

 const correct=examQuestions.filter(q=>{
   const answer=answers[q.id];
   const expected=String(q.answer||'').trim().toLowerCase();
   const selected=String(answer||'').trim().toLowerCase();
   return expected&&selected&&(
     selected===expected ||
     selected.startsWith(expected+')') ||
     expected.startsWith(selected+')')
   );
 }).length;

 const answered=Object.keys(answers).length;
 const score=correct;
 const percentage=examQuestions.length
   ? Math.round(correct/examQuestions.length*100)
   : 0;

 if(submitted){
   return (
    <div className="exam-page">
     <section className="result-card">
      <span className="kicker">TEST COMPLETE</span>
      <h2>পরীক্ষা শেষ</h2>

      <div className="score-circle">
       <b>{percentage}%</b>
       <span>Score</span>
      </div>

      <div className="result-grid">
       <div><b>{score}</b><span>Correct</span></div>
       <div><b>{examQuestions.length-score}</b><span>Wrong</span></div>
       <div><b>{examQuestions.length-answered}</b><span>Unanswered</span></div>
       <div><b>{examQuestions.length}</b><span>Total</span></div>
      </div>

      <div className="result-actions">
       <button onClick={()=>setStarted(false)}>New Test</button>
       <button onClick={()=>{setSubmitted(false);setCurrent(0)}}>Review Answers</button>
      </div>
     </section>

     <section className="review-list">
      <h3>Question Review</h3>

      {examQuestions.map((q,i)=>{
       const selected=answers[q.id];
       const expected=q.answer;
       const isCorrect=String(selected||'').trim().toLowerCase()===
                        String(expected||'').trim().toLowerCase();

       return (
        <article className={`review-item ${isCorrect?'review-correct':'review-wrong'}`} key={q.id}>
         <div className="review-number">Q{i+1}</div>
         <div className="review-body">
          <b>{q.q}</b>
          <p>Your answer: {selected||'Not answered'}</p>
          <p>Correct answer: {expected||'Source answer unavailable'}</p>
         </div>
         <strong>{isCorrect?'✓':'✕'}</strong>
        </article>
       )
      })}
     </section>
    </div>
   )
 }

 const q=examQuestions[current];
 const options=q.options||[];

 const mins=Math.floor(seconds/60).toString().padStart(2,'0');
 const secs=(seconds%60).toString().padStart(2,'0');
 const progress=Math.round(((current+1)/examQuestions.length)*100);

 return (
  <div className="exam-page">
   <section className="exam-running-head">
    <div>
     <span>QUESTION {current+1} / {examQuestions.length}</span>
     <div className="exam-progress">
      <div style={{width:`${progress}%`}}></div>
     </div>
    </div>

    <div className={`exam-timer ${seconds<=60?'timer-danger':''}`}>
     ⏱ {mins}:{secs}
    </div>
   </section>

   <section className="exam-question">
    <div className="exam-q-meta">
     <span>{q.year||'Practice'}</span>
     <span>{q.concept||'Physics'}</span>
    </div>

    <h2>{q.q}</h2>

    <div className="exam-options-list">
     {options.map((option,i)=>{
       const letter=String.fromCharCode(0x0995+i);
       const selected=answers[q.id]===option;

       return (
        <button
         key={i}
         className={selected?'exam-option selected':'exam-option'}
         onClick={()=>choose(option)}
        >
         <span>{letter})</span>
         <b>{option}</b>
        </button>
       )
     })}
    </div>
   </section>

   <section className="exam-navigation">
    <button
     disabled={current===0}
     onClick={()=>setCurrent(Math.max(0,current-1))}
    >
     ← Previous
    </button>

    {current<examQuestions.length-1 ? (
     <button
      className="exam-next"
      onClick={()=>setCurrent(current+1)}
     >
      Next →
     </button>
    ):(
     <button className="exam-submit" onClick={submit}>
      Submit Test
     </button>
    )}
   </section>

   <div className="exam-answer-status">
    Answered {answered} / {examQuestions.length}
   </div>
  </div>
 )
}


createRoot(document.getElementById('root')).render(<App/>);
