    return (
      <svg viewBox="0 0 700 380" className="diagram-svg">
        <line x1="40" y1="190" x2="660" y2="190" stroke="currentColor" strokeWidth="2"/>
        <polyline points={pts.join(' ')} fill="none" stroke="currentColor" strokeWidth="4"/>
        <text x="300" y="330">λ = wavelength</text>
        <text x="55" y="110">Amplitude</text>
      </svg>
    );
  }

  if(type === 'mirror' || type === 'refraction') {
    return (
      <svg viewBox="0 0 700 420" className="diagram-svg">
        <line x1="350" y1="55" x2="350" y2="365" stroke="currentColor" strokeWidth="6"/>
        <line x1="80" y1="210" x2="620" y2="210" stroke="currentColor" strokeWidth="2" strokeDasharray="8 8"/>
        <line x1="130" y1="80" x2="350" y2="210" stroke="currentColor" strokeWidth="4"/>
