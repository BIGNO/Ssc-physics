function DiagramBoard({chapter,state,update}) {
  const saved = state.diagrams?.[chapter.id] || {};
  const [values,setValues] = useState({
    objectDistance: saved.objectDistance ?? 120,
    focalLength: saved.focalLength ?? 60,
    angle: saved.angle ?? 30,
    label: saved.label ?? chapter.title
  });

  const change = (key,value) => {
    const next = {...values,[key]:value};
    setValues(next);
    update({
      diagrams:{
        ...state.diagrams,
        [chapter.id]:next
      }
    });
  };

  const keyword = `${chapter.title} ${chapter.focus} ${(chapter.concepts||[]).map(x=>x.title).join(' ')}`.toLowerCase();

  let type = 'generic';
  if (keyword.includes('গতি') || keyword.includes('motion')) type = 'motion';
  else if (keyword.includes('বল') || keyword.includes('force')) type = 'force';
  else if (keyword.includes('তরঙ্গ') || keyword.includes('wave')) type = 'wave';
  else if (keyword.includes('চাপ') || keyword.includes('pressure')) type = 'pressure';
  else if (keyword.includes('তাপ') || keyword.includes('heat')) type = 'heat';
  else if (keyword.includes('প্রতিফলন') || keyword.includes('mirror')) type = 'mirror';
  else if (keyword.includes('প্রতিসরণ') || keyword.includes('lens') || keyword.includes('refraction')) type = 'refraction';
  else if (keyword.includes('চল তড়িৎ') || keyword.includes('circuit') || keyword.includes('বিদ্যুৎ')) type = 'circuit';
  else if (keyword.includes('চৌম্বক') || keyword.includes('magnetic')) type = 'magnetic';
  else if (keyword.includes('motor') || keyword.includes('মোটর')) type = 'motor';
  else if (keyword.includes('generator') || keyword.includes('জেনারেটর')) type = 'generator';
  else if (keyword.includes('transformer') || keyword.includes('ট্রান্সফরমার')) type = 'transformer';
  else if (keyword.includes('পরমাণু') || keyword.includes('nuclear') || keyword.includes('semiconductor')) type = 'atom';

  return (
    <section className="diagram-page">
      <div className="panel">
        <div className="panel-head">
          <div>
            <span className="kicker">EDITABLE DIAGRAM BOARD</span>
            <h2>{chapter.title}</h2>
            <p>নিচের মানগুলো পরিবর্তন করে diagram practice করো।</p>
          </div>
          <span className="badge">LIVE</span>
        </div>

        <div className="diagram-layout">
          <div className="diagram-controls">
            <label>
              Object Distance
              <input
                type="number"
                value={values.objectDistance}
                onChange={e=>change('objectDistance',Number(e.target.value))}
              />
            </label>

            <label>
              Focal Length
              <input
                type="number"
                value={values.focalLength}
                onChange={e=>change('focalLength',Number(e.target.value))}
              />
            </label>

            <label>
              Angle
              <input
                type="number"
                value={values.angle}
                onChange={e=>change('angle',Number(e.target.value))}
              />
            </label>

            <label>
              Diagram Label
              <input
                value={values.label}
                onChange={e=>change('label',e.target.value)}
              />
            </label>

            <button
              className="primary-btn"
              onClick={()=>{
                const reset={
                  objectDistance:120,
                  focalLength:60,
                  angle:30,
                  label:chapter.title
                };
                setValues(reset);
                update({
                  diagrams:{
                    ...state.diagrams,
                    [chapter.id]:reset
                  }
                });
              }}
            >
              Reset Diagram
            </button>
          </div>

          <div className="diagram-canvas">
            <DiagramSVG
              type={type}
              values={values}
            />
          </div>
        </div>
      </div>

      <div className="panel">
        <div className="panel-head">
          <div>
            <span className="kicker">CONCEPTS</span>
            <h2>এই chapter-এর diagram topics</h2>
          </div>
        </div>

        <div className="quick-actions">
          {(chapter.concepts||[]).slice(0,8).map((c,i)=>(
            <div key={c.id||i} className="quick-item">
              <strong>{c.title}</strong>
              <span>Diagram concept</span>
            </div>
          ))}
        </div>
      </div>
    </section>
  );
}

function DiagramSVG({type,values}) {
  const angle = Number(values?.angle || 30);
  const objectDistance = Number(values?.objectDistance || 120);
  const focalLength = Number(values?.focalLength || 60);

  if(type === 'motion') {
    return (
      <svg viewBox="0 0 700 380" className="diagram-svg">
        <line x1="70" y1="290" x2="630" y2="290" stroke="currentColor" strokeWidth="3"/>
        <circle cx="150" cy="290" r="18" fill="currentColor"/>
        <circle cx="350" cy="290" r="18" fill="currentColor"/>
        <circle cx="550" cy="290" r="18" fill="currentColor"/>
        <line x1="150" y1="245" x2="550" y2="245" stroke="currentColor" strokeWidth="2"/>
        <polygon points="550,245 530,235 530,255" fill="currentColor"/>
        <text x="135" y="225">A</text>
        <text x="335" y="225">B</text>
        <text x="535" y="225">C</text>
        <text x="270" y="340">Motion / Position</text>
      </svg>
    );
  }

  if(type === 'force') {
    return (
      <svg viewBox="0 0 700 380" className="diagram-svg">
        <rect x="280" y="145" width="140" height="90" rx="8" fill="none" stroke="currentColor" strokeWidth="4"/>
        <line x1="120" y1="190" x2="280" y2="190" stroke="currentColor" strokeWidth="4"/>
        <polygon points="280,190 255,178 255,202" fill="currentColor"/>
        <line x1="420" y1="190" x2="580" y2="190" stroke="currentColor" strokeWidth="4"/>
        <polygon points="580,190 555,178 555,202" fill="currentColor"/>
        <text x="315" y="195">F</text>
        <text x="265" y="285">Force on object</text>
      </svg>
    );
  }

  if(type === 'wave') {
    const pts=[];
    for(let x=40;x<=660;x+=5){
      const y=190-65*Math.sin((x/620)*Math.PI*4);
      pts.push(`${x},${y}`);
