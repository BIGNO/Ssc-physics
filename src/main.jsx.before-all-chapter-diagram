        )}

        <text x="451" y="321" className="prb-component">
          GENERATOR
        </text>

        <text x="265" y="470" className="prb-blue">
          Faster rotation → greater induced emf
        </text>

      </Frame>
    );
  }

  if(type==="transformer"){

    const vp=Number(values.primaryVoltage);
    const np=Number(values.primaryTurns);
    const ns=Number(values.secondaryTurns);

    const vs=vp*ns/Math.max(1,np);

    return (
      <Frame
        title="Transformer"
        subtitle={`Vp = ${vp} V   •   Np = ${np}   •   Ns = ${ns}`}
      >

        <rect
          x="370"
          y="175"
          width="260"
          height="280"
          rx="18"
          className="prb-transformer"
        />

        <path
          d="M430 205 Q350 315 430 425"
          className="prb-coil"
        />

        <path
          d="M570 205 Q650 315 570 425"
          className="prb-coil"
        />

