        </text>

      </Frame>
    );
  }

  if(type==="wave"){

    const lambda=Number(values.wavelength);
    const amp=Number(values.amplitude);
    const freq=Number(values.frequency);

    let d="M70 330";

    for(let x=70;x<=910;x+=6){
      const y=
        330+
        amp*
        Math.sin(((x-70)/lambda)*Math.PI*2);

      d+=` L${x} ${y}`;
    }

    return (
      <Frame
        title="Wave"
        subtitle={`λ = ${lambda} px   •   A = ${amp} px   •   f = ${freq} Hz`}
      >

        <line x1="70" y1="330" x2="910" y2="330" className="prb-axis"/>

