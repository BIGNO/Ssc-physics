    const v=Number(values.velocity);
    const a=Number(values.acceleration);
    const t=Number(values.time);

    const distance=v*t+.5*a*t*t;

    return (
      <Frame
        title="Motion"
        subtitle={`v = ${v} m/s   •   a = ${a} m/s²   •   t = ${t} s`}
      >

        <line
          x1="80"
          y1="385"
          x2="900"
          y2="385"
