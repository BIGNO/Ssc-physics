      </Frame>
    );
  }

  if(type==="force"){

    const F=Number(values.force);
    const m=Number(values.mass);
    const angle=Number(values.angle);

    const L=Math.min(280,60+F*4);
    const r=angle*Math.PI/180;

    const x2=470+L*Math.cos(r);
    const y2=380-L*Math.sin(r);

    return (
      <Frame
        title="Force & Vector"
        subtitle={`F = ${F} N   •   m = ${m} kg   •   θ = ${angle}°`}
      >

        <line
