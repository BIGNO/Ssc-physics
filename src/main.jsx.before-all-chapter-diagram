  if(type==="motor"){

    const current=Number(values.current);
    const strength=Number(values.strength);
    const turns=Number(values.turns);

    return (
      <Frame
        title="Electric Motor"
        subtitle={`I = ${current} A   •   B = ${strength}   •   turns = ${turns}`}
      >

        <circle
          cx="500"
          cy="315"
          r="110"
          className="prb-coil"
        />

        <circle
          cx="500"
          cy="315"
          r="38"
          className="prb-core"
        />

        <line
          x1="390"
          y1="315"
          x2="610"
          y2="315"
          className="prb-axis"
        />

        <path
          d="M500 205 Q340 120 235 215"
          className="prb-field"
        />

        <path
          d="M500 425 Q660 510 765 415"
          className="prb-field"
        />

        <text x="455" y="321" className="prb-component">
          MOTOR
        </text>

      </Frame>
    );
  }

  if(type==="generator"){

    const speed=Number(values.speed);
    const strength=Number(values.strength);

    return (
      <Frame
        title="Generator"
        subtitle={`speed = ${speed} rpm   •   field strength = ${strength}`}
      >

        <circle
          cx="500"
          cy="315"
          r="110"
          className="prb-coil"
        />

        <circle
          cx="500"
          cy="315"
          r="30"
          className="prb-core"
        />

        {playing && (
          <circle
            cx="500"
            cy="205"
            r="11"
            className="prb-motion-object"
          >
            <animateMotion
