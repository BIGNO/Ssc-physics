  if(type==="heat"){

    const T=Number(values.temperature);
    const fill=Math.max(10,Math.min(210,T*2.1));

    return (
      <Frame
        title="Temperature"
        subtitle={`T = ${T}°C   •   m = ${values.mass} kg`}
      >

        <rect
