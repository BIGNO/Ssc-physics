    const amplitude = clampValue(values.amplitude,1,15,5);

    const ampPx = Math.min(90,amplitude*6);
    const wavePx = Math.max(70,wavelength*18);

    let path = "M70 275";

    for(let x=70;x<=830;x+=8){
      const y =
        275 +
        ampPx*
        Math.sin(((x-70)/wavePx)*Math.PI*2);

      path += ` L${x} ${y}`;
    }

    return frame(
      "Wave — Wavelength & Amplitude",
      `λ = ${wavelength} m   •   A = ${amplitude} cm   •   f = ${values.frequency} Hz`,
