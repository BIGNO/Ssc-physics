          className="wave-main"
          filter={`url(#glow-${uid})`}
        >
          {playing && (
            <animate
              attributeName="stroke-dashoffset"
              from="0"
              to="-180"
              dur="2s"
              repeatCount="indefinite"
            />
          )}
