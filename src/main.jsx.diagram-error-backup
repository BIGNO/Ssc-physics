  if(type === "atom"){
    const p = Math.max(1,Math.min(12,Math.round(values.protons)));
    const e = Math.max(1,Math.min(12,Math.round(values.electrons)));

    const electrons = [];

    const first = Math.min(2,e);
    const second = Math.max(0,e-first);

    for(let i=0;i<first;i++){
      const a = (i/first)*Math.PI*2;
      electrons.push({
        x:450+105*Math.cos(a),
        y:270+105*Math.sin(a)
      });
    }

    for(let i=0;i<second;i++){
      const a = (i/Math.max(1,second))*Math.PI*2;
      electrons.push({
        x:450+180*Math.cos(a),
        y:270+180*Math.sin(a)
      });
    }

    return frame(
      "Atomic Structure",
      `protons = ${p}   •   neutrons = ${values.neutrons}   •   electrons = ${e}`,
      <g>

        <circle cx="450" cy="270" r="48" className="nucleus"/>
