function clampNumber(value, min, max, fallback) {
  const n = Number(value);
  if (!Number.isFinite(n)) return fallback;
  return Math.min(max, Math.max(min, n));
}

function getDiagramType(chapterTitle="", conceptTitle="") {
  const text = `${chapterTitle} ${conceptTitle}`.toLowerCase();

  if (
    /গতি|দূরত্ব|সরণ|বেগ|দ্রুতি|ত্বরণ|motion|velocity|speed|acceleration|distance|displacement/.test(text)
  ) return "motion";

  if (
    /তরঙ্গ|কম্পন|শব্দ|wave|vibration|sound|frequency|wavelength|amplitude/.test(text)
  ) return "wave";

  if (
    /বিদ্যুৎ|তড়িৎ|তড়িৎ|current|voltage|resistance|circuit|ওহম|ohm|series|parallel/.test(text)
  ) return "circuit";

  if (
    /বল|force|নিউটন|newton|ভর|mass|momentum|ঘর্ষণ|friction|weight/.test(text)
  ) return "force";

  if (
    /লেন্স|lens|দর্পণ|mirror|ফোকাস|focus|focal|আয়না|আয়না|প্রতিচ্ছবি|image formation/.test(text)
  ) {
    if (/লেন্স|lens/.test(text)) return "lens";
    return "mirror";
  }

  if (
    /কাজ|শক্তি|ক্ষমতা|work|energy|power|kinetic|potential|গতিশক্তি|বিভব/.test(text)
  ) return "energy";

  if (
    /তাপ|তাপমাত্রা|thermal|temperature|heat|calor|উষ্ণতা/.test(text)
  ) return "heat";

  if (
    /পরমাণু|atom|electron|proton|neutron|nucleus|ইলেকট্রন|প্রোটন|নিউট্রন/.test(text)
  ) return "atom";

  if (
    /চুম্বক|magnet|magnetic|field|চৌম্বক|electromagnet/.test(text)
  ) return "magnet";

  return "generic";
}

function clampValue(n,min,max,fallback){
  const x = Number(n);
  if(!Number.isFinite(x)) return fallback;
  return Math.max(min,Math.min(max,x));
}

function detectDiagramType(title="",focus=""){
  const t = `${title} ${focus}`.toLowerCase();

  if(/লেন্স|lens/.test(t)) return "lens";
  if(/দর্পণ|আয়না|আয়না|mirror/.test(t)) return "mirror";
  if(/গতি|বেগ|দ্রুতি|ত্বরণ|motion|velocity|speed|acceleration/.test(t)) return "motion";
  if(/তরঙ্গ|শব্দ|কম্পন|wave|sound|vibration/.test(t)) return "wave";
  if(/বিদ্যুৎ|তড়িৎ|তড়িৎ|current|voltage|resistance|circuit|ohm|ওহম/.test(t)) return "circuit";
  if(/বল|ঘর্ষণ|নিউটন|force|friction|newton|momentum/.test(t)) return "force";
  if(/কাজ|শক্তি|ক্ষমতা|energy|work|power|kinetic|potential/.test(t)) return "energy";
  if(/তাপ|তাপমাত্রা|heat|temperature|thermal/.test(t)) return "heat";
  if(/পরমাণু|ইলেকট্রন|প্রোটন|নিউট্রন|atom|electron|proton|neutron/.test(t)) return "atom";
  if(/চুম্বক|চৌম্বক|magnet|magnetic/.test(t)) return "magnet";

  return "motion";
}

