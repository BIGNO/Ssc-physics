        <line
          x1="150"
          y1={275-ampPx}
          x2="150"
          y2="275"
          className="dimension-line"
        />

        <text
          x="165"
          y={255-ampPx}
          className="value-primary"
        >
          A = {amplitude}
        </text>

        <line
          x1="230"
          y1="350"
          x2={230+wavePx}
          y2="350"
          className="dimension-line"
        />

        <text x="280" y="380" className="value-accent">
          λ = {wavelength}
