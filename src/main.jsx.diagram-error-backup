function getDiagramData(type,saved={}){
  const defaults = DIAGRAM_DEFAULTS[type] || DIAGRAM_DEFAULTS.motion;
  return {
    ...defaults,
    ...saved,
    type
  };
}

function DiagramBoard({chapter,state,update}) {
  const autoType = detectDiagramType(
    chapter?.title || "",
    chapter?.focus || ""
  );

  const saved = state.diagrams?.[chapter.id] || {};
  const initialType = saved.type || autoType;

  const [activeType,setActiveType] = useState(initialType);
  const [playing,setPlaying] = useState(true);

  const values = getDiagramData(activeType,saved);

  const setValue = (key,value) => {
    update({
      diagrams:{
        ...state.diagrams,
        [chapter.id]:{
          ...values,
          [key]:Number(value)
        }
      }
    });
  };

  const setType = (type) => {
    const next = getDiagramData(type,{});

    setActiveType(type);

    update({
      diagrams:{
        ...state.diagrams,
        [chapter.id]:next
      }
    });
  };

  const reset = () => {
    const next = getDiagramData(autoType,{});

    setActiveType(autoType);

    update({
      diagrams:{
        ...state.diagrams,
        [chapter.id]:next
      }
    });
  };

  const cfg = {
    lens:[
      ["Focal Length (f)","focalLength",1,40,1,"cm"],
      ["Object Distance (u)","objectDistance",5,80,1,"cm"],
      ["Object Height","objectHeight",2,20,1,"cm"]
    ],
    mirror:[
      ["Focal Length (f)","focalLength",1,40,1,"cm"],
      ["Object Distance (u)","objectDistance",5,80,1,"cm"],
      ["Object Height","objectHeight",2,20,1,"cm"]
    ],
    motion:[
      ["Velocity (v)","velocity",0,30,.5,"m/s"],
      ["Acceleration (a)","acceleration",0,10,.5,"m/s²"],
      ["Time (t)","time",1,20,.5,"s"]
    ],
    wave:[
      ["Wavelength (λ)","wavelength",2,30,.5,"m"],
      ["Amplitude (A)","amplitude",1,15,.5,"cm"],
      ["Frequency (f)","frequency",1,10,.5,"Hz"]
    ],
    circuit:[
      ["Voltage (V)","voltage",1,24,1,"V"],
      ["Resistance (R)","resistance",1,30,1,"Ω"]
    ],
    force:[
      ["Force (F)","force",1,60,1,"N"],
      ["Mass (m)","mass",1,30,1,"kg"],
      ["Angle (θ)","angle",0,89,1,"°"]
    ],
    energy:[
      ["Mass (m)","mass",1,30,1,"kg"],
      ["Height (h)","height",1,30,1,"m"],
      ["Gravity (g)","gravity",9.8,10,0.1,"m/s²"]
    ],
    heat:[
      ["Temperature (T)","temperature",0,100,1,"°C"],
      ["Mass (m)","mass",1,10,.5,"kg"],
      ["Specific Heat (c)","specificHeat",1,10,.1,"kJ/kg°C"]
    ],
    atom:[
      ["Protons (p⁺)","protons",1,12,1,""],
      ["Neutrons (n⁰)","neutrons",0,18,1,""],
      ["Electrons (e⁻)","electrons",1,12,1,""]
    ],
    magnet:[
      ["Field Strength","strength",1,12,1,""],
      ["Distance","distance",1,20,1,"cm"],
      ["Current (I)","current",1,10,.5,"A"]
    ]
  }[activeType] || [];

  let primaryMetric = "";
  let status = "";

  if(activeType === "lens"){
    const f = Math.max(.1,values.focalLength);
    const u = Math.max(.1,values.objectDistance);
    const v = (u*f)/(u-f);
    const mag = -v/u;

    primaryMetric = Number.isFinite(v)
      ? `v = ${v.toFixed(1)} cm | m = ${mag.toFixed(2)}`
      : "v → ∞";

    status =
      u > 2*f ? "Real, Inverted, Diminished" :
      u === 2*f ? "Real, Inverted, Same Size" :
      u > f ? "Real, Inverted, Enlarged" :
      "Virtual, Upright, Enlarged";
  }

  if(activeType === "mirror"){
    const f = Math.max(.1,values.focalLength);
    const u = Math.max(.1,values.objectDistance);
    const v = (u*f)/(u-f);
    const mag = -v/u;

    primaryMetric = Number.isFinite(v)
      ? `v = ${v.toFixed(1)} cm | m = ${mag.toFixed(2)}`
      : "v → ∞";

    status =
      u > 2*f ? "Real, Inverted, Diminished" :
      u === 2*f ? "Real, Inverted, Same Size" :
      u > f ? "Real, Inverted, Enlarged" :
      "Virtual, Upright, Enlarged";
  }

  if(activeType === "motion"){
    const distance =
      values.velocity * values.time +
      .5 * values.acceleration * values.time * values.time;

    primaryMetric = `s = ${distance.toFixed(1)} m`;

    status = values.acceleration === 0
      ? "Uniform Motion"
      : "Accelerated Motion";
  }

  if(activeType === "wave"){
    const wavelength = Math.max(.1,values.wavelength);
    const frequency = Math.max(.1,values.frequency);
    const speed = wavelength * frequency;

    primaryMetric = `v = ${speed.toFixed(1)} m/s`;
    status = `A = ${values.amplitude} cm`;
  }

  if(activeType === "circuit"){
    const voltage = values.voltage;
    const resistance = Math.max(.1,values.resistance);
    const current = voltage/resistance;
    const power = voltage*current;

    primaryMetric = `I = ${current.toFixed(2)} A`;
    status = `P = ${power.toFixed(1)} W`;
  }

  if(activeType === "force"){
    const acceleration = values.force/Math.max(.1,values.mass);

    primaryMetric = `a = ${acceleration.toFixed(2)} m/s²`;
    status = `F = ${values.force} N`;
  }

  if(activeType === "energy"){
    const pe = values.mass*values.gravity*values.height;

    primaryMetric = `PE = ${pe.toFixed(1)} J`;
    status = "Gravitational Potential Energy";
  }

  if(activeType === "heat"){
    const q =
      values.mass*
      values.specificHeat*
      values.temperature;

    primaryMetric = `Q ≈ ${q.toFixed(1)} kJ`;
    status = "Thermal Energy";
  }

  if(activeType === "atom"){
    primaryMetric = `Z = ${values.protons}`;
    status = `Electrons = ${values.electrons}`;
  }

  if(activeType === "magnet"){
    primaryMetric = `B ∝ ${values.strength}`;
    status = `I = ${values.current} A`;
  }

  return (
    <section className="physics-lab-board">

      <div className="physics-lab-header">
        <div>
          <div className="physics-lab-brand">
            Class 9–10 Physics Lab
          </div>
          <div className="physics-lab-chapter">
            Interactive Physics Visualization
          </div>
        </div>

        <div className="physics-lab-actions">
          <button
            type="button"
            onClick={()=>setPlaying(x=>!x)}
            className="lab-round-btn"
            title={playing ? "Pause" : "Play"}
          >
            {playing ? "Ⅱ" : "▶"}
          </button>

          <button
            type="button"
            onClick={reset}
            className="lab-round-btn"
            title="Reset"
          >
            ↻
          </button>
        </div>
      </div>

      <div className="physics-lab-canvas">
        <DiagramSVG
          type={activeType}
          values={values}
          playing={playing}
        />
      </div>

      <div className="physics-lab-metrics">

        <div className="lab-metric-card">
          <span>PRIMARY METRIC</span>
          <strong>{primaryMetric}</strong>
        </div>

        <div className="lab-divider"></div>

        <div className="lab-metric-card">
          <span>STATUS</span>
          <strong>{status}</strong>
        </div>

      </div>

      <div className="physics-lab-controls">

        <div className="lab-select-row">
          <label>Physics Chapter</label>

          <select
            value={activeType}
            onChange={(e)=>setType(e.target.value)}
          >
            <option value="motion">Motion</option>
            <option value="force">Force</option>
            <option value="wave">Wave & Sound</option>
            <option value="lens">Lens / Optics</option>
            <option value="mirror">Mirror / Optics</option>
            <option value="circuit">Electricity</option>
            <option value="energy">Work & Energy</option>
            <option value="heat">Heat & Temperature</option>
            <option value="atom">Atomic Structure</option>
            <option value="magnet">Magnetism</option>
          </select>
        </div>

        <div className="lab-slider-stack">

          {cfg.map(([label,key,min,max,step,unit])=>(
            <div className="lab-slider-row" key={key}>

              <div className="lab-slider-label">
                <span>{label}</span>
              </div>

              <input
                type="range"
                min={min}
                max={max}
                step={step}
                value={values[key]}
                onChange={(e)=>setValue(key,e.target.value)}
              />

              <div className="lab-number-box">
                <span>{values[key]}</span>
                {unit && <small>{unit}</small>}
              </div>

            </div>
          ))}

        </div>

      </div>

    </section>
  );
}

function DiagramSVG({type,values,playing=true}) {

  const uid = `${type}-${String(values?.focalLength || values?.velocity || "x")}`;

  const W = 900;
  const H = 520;

  const lensDefs = (
    <defs>
      <marker
        id={`arrow-${uid}`}
        markerWidth="12"
        markerHeight="12"
        refX="10"
        refY="6"
        orient="auto"
