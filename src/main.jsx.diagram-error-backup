        <line x1="110" y1="360" x2="790" y2="360" className="motion-track"/>

        <rect
          x="350"
          y="280"
          width="140"
          height="80"
          rx="12"
          className="force-block"
        />

        <text x="385" y="327" className="block-text">
          {mass} kg
        </text>

        <line
          x1="420"
          y1="320"
          x2={x2}
          y2={y2}
          className="vector-primary"
          markerEnd={`url(#arrow-${uid})`}
          filter={`url(#glow-${uid})`}
        />

        <line
          x1="420"
          y1="320"
          x2="420"
          y2="200"
          className="vector-secondary"
