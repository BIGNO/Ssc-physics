    const height = Math.max(.1,Number(values.height)||10);
    const gravity = Math.max(.1,Number(values.gravity)||9.8);
    const pe = mass*gravity*height;

    const bar = Math.min(250,35+pe/6);

    return frame(
      "Potential Energy — mgh",
      `m = ${mass} kg   •   h = ${height} m   •   g = ${gravity} m/s²`,
      <g>

        <line x1="100" y1="385" x2="800" y2="385" className="motion-track"/>

        <rect
          x="160"
          y={385-bar}
          width="130"
          height={bar}
          rx="15"
          className="energy-bar"
        />

        <text x="150" y="420" className="component-text">
          Potential Energy
        </text>

        <text x="145" y={370-bar} className="value-primary">
          PE = {pe.toFixed(1)} J
        </text>

        <rect
          x="540"
          y="310"
          width="75"
          height="75"
          rx="10"
          className="energy-object"
        />

        <line
          x1="578"
          y1="310"
          x2="578"
