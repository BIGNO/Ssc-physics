                from="0 450 270"
                to="360 450 270"
                dur={`${3+i*.15}s`}
                repeatCount="indefinite"
              />
            )}
          </circle>
        ))}

        <text x="125" y="420" className="svg-measurement">
          Electron configuration shown visually
        </text>

      </g>
    );
  }

  if(type === "magnet"){
    const strength = clampValue(values.strength,1,12,6);

    return frame(
      "Magnetic Field",
      `field strength = ${strength}   •   I = ${values.current} A`,
      <g>

        <rect x="355" y="225" width="95" height="80" rx="10" className="magnet-n"/>
        <rect x="450" y="225" width="95" height="80" rx="10" className="magnet-s"/>

        <text x="390" y="278" className="magnet-letter">N</text>
        <text x="488" y="278" className="magnet-letter">S</text>

        {Array.from({length:6}).map((_,i)=>(
          <path
            key={`top${i}`}
            d={`M${355-i*28} 225 Q450 ${85-i*10} ${545+i*28} 225`}
            className="field-line"
          />
        ))}

        {Array.from({length:6}).map((_,i)=>(
          <path
            key={`bottom${i}`}
            d={`M${355-i*28} 305 Q450 ${455+i*10} ${545+i*28} 305`}
            className="field-line"
          />
        ))}

        <text x="285" y="420" className="value-accent">
          Field-line density represents magnetic strength
        </text>

      </g>
    );
  }

  return frame(
    "Physics Experiment",
    "Interactive visualization",
    <g>
      <circle cx="450" cy="270" r="55" className="motion-dot"/>
      <line
        x1="230"
        y1="270"
        x2="370"
        y2="270"
        className="vector-primary"
        markerEnd={`url(#arrow-${uid})`}
      />
      <text x="350" y="215" className="value-primary">
        Interactive
      </text>
    </g>
  );
}


function Learn({chapter}) {
  const [openConcept,setOpenConcept]=useState(null);
  const [completed,setCompleted]=useState({});

  const toggleComplete=(id)=>{
    setCompleted(prev=>({...prev,[id]:!prev[id]}));
  };

  const completedCount=Object.values(completed).filter(Boolean).length;
  const total=chapter.concepts?.length||0;
  const percent=total ? Math.round(completedCount/total*100) : 0;

  return (
