        <line x1="150" y1="215" x2="150" y2="315" className="battery-long"/>
        <line x1="190" y1="235" x2="190" y2="295" className="battery-short"/>

        <rect
          x="390"
          y="132"
          width="125"
          height="45"
          rx="10"
          className="resistor-box"
        />

        <path
          d="M402 154 l15 -17 l15 34 l15 -34 l15 34 l15 -17"
          className="resistor-wave"
        />

        <circle cx="625" cy="265" r="35" className="bulb-circle"/>
        <path d="M609 242 Q625 265 641 242" className="bulb-filament"/>

        {playing && (
          <line
            x1="205"
            y1="150"
            x2="330"
            y2="150"
            className="current-arrow"
            markerEnd={`url(#arrow-${uid})`}
          />
