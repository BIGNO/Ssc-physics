        <text x="245" y="125" className="value-primary">
          I = {I.toFixed(2)} A
        </text>

        <text x="415" y="122" className="component-text">
          R = {R} Ω
        </text>

        <text x="106" y="350" className="component-text">
          V = {V} V
        </text>

        <text x="380" y="445" className="svg-measurement">
