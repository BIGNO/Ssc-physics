/* ==========================
   STEP 6 — EXAM MODE
   ========================== */

.exam-page{
  display:flex;
  flex-direction:column;
  gap:18px;
}

.exam-hero{
  display:flex;
  justify-content:space-between;
  align-items:center;
  padding:30px;
  border-radius:22px;
  background:linear-gradient(135deg,#111c31,#203958);
  color:#fff;
}

.exam-hero h2{
  margin:7px 0;
  font-size:30px;
}

.exam-hero p{
  margin:0;
  opacity:.78;
}

.exam-icon{
  font-size:60px;
  opacity:.6;
}

.exam-setup{
  background:#fff;
  border:1px solid #e3e8ef;
  border-radius:18px;
  padding:24px;
}

.exam-setup h3{
  margin:0 0 18px;
}

.exam-options{
  display:grid;
  grid-template-columns:2fr 1fr 1fr;
  gap:12px;
}

.exam-options label{
  display:flex;
  flex-direction:column;
  gap:7px;
}

.exam-options label span{
  font-size:12px;
  font-weight:700;
  color:#647187;
}

.exam-options select{
  padding:12px;
  border:1px solid #d9e0e9;
  border-radius:10px;
  background:#fff;
}

.exam-start{
  margin-top:18px;
  border:0;
  border-radius:11px;
  background:#15253c;
  color:#fff;
  padding:12px 19px;
  cursor:pointer;
  font-weight:800;
}

.exam-rules{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:12px;
}

.exam-rules>div{
  display:flex;
  align-items:center;
  gap:12px;
  background:#fff;
  border:1px solid #e4e8ee;
  border-radius:14px;
  padding:15px;
}

.exam-rules b{
  width:32px;
  height:32px;
  display:grid;
  place-items:center;
  border-radius:9px;
  background:#eef2f7;
  font-size:12px;
}

.exam-rules span{
  font-size:13px;
  color:#58667b;
}

.exam-running-head{
  display:flex;
  justify-content:space-between;
  align-items:center;
  background:#fff;
  border:1px solid #e3e8ef;
  border-radius:15px;
  padding:15px 18px;
}

.exam-running-head>div:first-child{
  width:60%;
}

.exam-running-head span{
  font-size:12px;
  font-weight:800;
  color:#65738a;
}

.exam-progress{
  height:6px;
  background:#e9edf2;
  border-radius:10px;
  overflow:hidden;
  margin-top:8px;
}

.exam-progress>div{
  height:100%;
  background:#334d6b;
  transition:.2s;
}

.exam-timer{
  font-size:20px;
  font-weight:900;
  letter-spacing:1px;
}

.timer-danger{
  color:#b44444;
}

.exam-question{
  background:#fff;
  border:1px solid #e3e8ef;
  border-radius:19px;
  padding:25px;
}

.exam-q-meta{
  display:flex;
  gap:8px;
  flex-wrap:wrap;
}

.exam-q-meta span{
  font-size:11px;
  background:#f1f4f8;
  padding:6px 9px;
  border-radius:7px;
  color:#66748a;
}

.exam-question h2{
  font-size:20px;
  line-height:1.6;
  margin:18px 0 22px;
}

.exam-options-list{
  display:flex;
  flex-direction:column;
  gap:10px;
}

.exam-option{
  display:flex;
  align-items:center;
  gap:13px;
  text-align:left;
  padding:14px;
  border:1px solid #dfe5ed;
  background:#fff;
  border-radius:12px;
  cursor:pointer;
  transition:.15s;
}

.exam-option:hover{
  border-color:#8797aa;
}

.exam-option.selected{
  border-color:#405977;
  background:#f0f4f8;
}

.exam-option>span{
  width:28px;
  height:28px;
  display:grid;
  place-items:center;
  border-radius:8px;
  background:#edf1f5;
  font-weight:800;
}

.exam-navigation{
  display:flex;
  justify-content:space-between;
  gap:10px;
}

.exam-navigation button,
.result-actions button{
  border:1px solid #d8dfe8;
  background:#fff;
  padding:11px 16px;
  border-radius:10px;
  cursor:pointer;
  font-weight:700;
}

.exam-navigation button:disabled{
  opacity:.4;
  cursor:not-allowed;
}

.exam-navigation .exam-next,
.exam-navigation .exam-submit{
  background:#15253c;
  color:#fff;
  border-color:#15253c;
}

.exam-answer-status{
  text-align:center;
  color:#758196;
  font-size:12px;
}

.result-card{
  background:#fff;
  border:1px solid #e1e7ee;
  border-radius:22px;
  padding:30px;
  text-align:center;
}

.result-card h2{
  margin:8px 0 20px;
}

.score-circle{
  width:135px;
  height:135px;
  border:8px solid #dfe6ee;
  border-radius:50%;
  display:flex;
  flex-direction:column;
  justify-content:center;
  align-items:center;
  margin:0 auto 25px;
}

.score-circle b{
  font-size:30px;
}

.score-circle span{
  font-size:12px;
  color:#748095;
}

.result-grid{
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:10px;
}

.result-grid>div{
  background:#f7f9fb;
  padding:15px;
  border-radius:12px;
}

.result-grid b{
  display:block;
  font-size:22px;
}

.result-grid span{
  font-size:11px;
  color:#748095;
}

.result-actions{
  display:flex;
  justify-content:center;
  gap:10px;
  margin-top:22px;
}

.result-actions button:first-child{
  background:#15253c;
  color:#fff;
}

.review-list{
  display:flex;
  flex-direction:column;
  gap:10px;
}

.review-list h3{
  margin:0;
}

.review-item{
  display:flex;
  align-items:flex-start;
  gap:12px;
  padding:15px;
  background:#fff;
  border:1px solid #e3e8ef;
  border-radius:13px;
}

.review-number{
  font-weight:900;
  min-width:35px;
}

.review-body{
  flex:1;
}

.review-body b{
  line-height:1.5;
}

.review-body p{
  margin:7px 0 0;
  font-size:12px;
  color:#68758a;
}

.review-item>strong{
  font-size:20px;
}

.review-correct{
  border-left:4px solid #6b8b72;
}

.review-wrong{
  border-left:4px solid #a86a6a;
}

@media(max-width:800px){
  .exam-options,
  .exam-rules{
    grid-template-columns:1fr;
  }

  .result-grid{
    grid-template-columns:1fr 1fr;
  }

  .exam-running-head>div:first-child{
    width:52%;
  }
}

@media(max-width:520px){
  .exam-hero{
    padding:22px;
  }

  .exam-icon{
    display:none;
  }

  .exam-question{
    padding:18px;
  }

  .exam-question h2{
    font-size:17px;
  }

  .result-actions{
    flex-direction:column;
  }
}

REFERENCE DIAGRAM BOARD CSS
/* =========================================================
