  margin:0 auto;
  padding:8px 26px 22px;
  display:grid;
  grid-template-columns:1fr 1px 1fr;
  gap:30px;
  align-items:center;
}

.prb-metrics span{
  display:block;
  margin-bottom:6px;
  color:#777e86;
  font-size:10px;
  font-weight:900;
  letter-spacing:1.5px;
}

.prb-metrics strong{
  color:#f5f7f9;
  font-size:15px;
}

.prb-separator{
  width:1px;
  height:30px;
  background:#3a3e43;
}

.prb-controls{
  max-width:850px;
  margin:0 auto;
  padding:0 26px 32px;
}

.prb-select-row{
  display:grid;
  grid-template-columns:135px minmax(0,1fr);
  gap:13px;
  align-items:center;
  margin-bottom:13px;
}

.prb-select-row label{
  color:#d7dbe0;
  font-size:12px;
  font-weight:700;
}

.prb-select-row select{
  width:100%;
  min-height:44px;
  padding:0 13px;
  border-radius:12px;
  border:1px solid #292d32;
  background:#171a1e;
  color:#f2f4f6;
}

.prb-sliders{
  display:grid;
  gap:12px;
  margin-top:17px;
}

.prb-slider{
  display:grid;
  grid-template-columns:160px minmax(0,1fr) 82px;
  gap:14px;
  align-items:center;
}

.prb-slider-name{
  color:#d8dde3;
  font-size:12px;
  font-weight:650;
}

.prb-slider input[type="range"]{
  width:100%;
  accent-color:#f2f4f6;
  cursor:pointer;
}

.prb-number{
  min-height:41px;
  border-radius:12px;
  background:#171a1e;
  display:flex;
  justify-content:center;
  align-items:center;
  gap:4px;
  font-size:14px;
  font-weight:800;
}

.prb-number small{
  color:#777f87;
  font-size:9px;
}

@keyframes referenceFieldFlow{
  from{stroke-dashoffset:0}
  to{stroke-dashoffset:-80}
}

@media(max-width:900px){
  .prb-canvas{
    min-height:320px;
    padding:0 4px;
  }

  .prb-metrics{
    grid-template-columns:1fr;
    gap:10px;
  }

  .prb-separator{
    display:none;
  }

  .prb-select-row{
    grid-template-columns:1fr;
  }

  .prb-slider{
    grid-template-columns:120px minmax(0,1fr) 70px;
  }
}

@media(max-width:560px){
  .prb-header{
    padding:18px 16px 13px;
  }

  .prb-header h2{
    font-size:20px;
  }

  .prb-controls{
    padding-left:16px;
    padding-right:16px;
  }

  .prb-slider{
    grid-template-columns:1fr 68px;
  }

  .prb-slider-name{
    grid-column:1/-1;
  }
}

/* =========================================================
   PREMIUM PHYSICS BACKGROUND
   Background-only redesign — existing layout preserved
   ========================================================= */

html,
body{
  background:
    radial-gradient(circle at 8% 8%, rgba(101,86,245,.13), transparent 28%),
    radial-gradient(circle at 88% 18%, rgba(45,155,255,.10), transparent 30%),
    radial-gradient(circle at 72% 88%, rgba(91,81,220,.08), transparent 32%),
    linear-gradient(135deg,#f4f7fc 0%,#eef3fa 48%,#f7f9fd 100%);
}

body{
  position:relative;
  overflow-x:hidden;
}

/* subtle scientific grid */
body::before{
  content:"";
  position:fixed;
  inset:0;
  pointer-events:none;
  z-index:0;
  opacity:.28;
  background-image:
    linear-gradient(rgba(82,104,140,.055) 1px,transparent 1px),
    linear-gradient(90deg,rgba(82,104,140,.055) 1px,transparent 1px);
  background-size:42px 42px;
}

/* very soft physics-lab glow */
body::after{
  content:"";
  position:fixed;
  width:520px;
  height:520px;
  right:-180px;
  bottom:-220px;
  pointer-events:none;
  z-index:0;
  border-radius:50%;
  background:
    radial-gradient(circle,
      rgba(101,86,245,.11) 0%,
      rgba(101,86,245,.045) 36%,
      transparent 70%);
  filter:blur(10px);
}

.app{
  position:relative;
  z-index:1;
  min-height:100vh;
  background:transparent;
}

.topbar{
  background:rgba(255,255,255,.84);
  backdrop-filter:blur(18px) saturate(140%);
  -webkit-backdrop-filter:blur(18px) saturate(140%);
  border-bottom:1px solid rgba(202,211,226,.72);
  box-shadow:
    0 6px 24px rgba(42,61,92,.07);
}

.sidebar{
  background:
    linear-gradient(
      180deg,
      rgba(248,250,255,.92),
      rgba(239,244,251,.88)
    );
  backdrop-filter:blur(16px);
  -webkit-backdrop-filter:blur(16px);
  border-right:1px solid rgba(205,214,228,.78);
}

.main{
  background:transparent;
}

/* glass cards */
.panel{
  background:rgba(255,255,255,.82);
  border:1px solid rgba(211,219,231,.82);
  box-shadow:
    0 14px 42px rgba(45,63,95,.055),
    0 2px 8px rgba(45,63,95,.025);
  backdrop-filter:blur(12px);
  -webkit-backdrop-filter:blur(12px);
}

/* slightly richer chapter cards */
.subject-card{
  box-shadow:
    0 10px 28px rgba(101,86,245,.09);
}

.chapter.active{
  box-shadow:
    0 10px 24px rgba(16,26,46,.18);
}

/* search glass */
.search{
  background:rgba(255,255,255,.78);
  box-shadow:
    inset 0 1px 0 rgba(255,255,255,.8);
}

/* richer hero separation */
.hero{
  position:relative;
}

.hero::before{
  content:"";
  position:absolute;
  left:-18px;
  right:-18px;
  top:-18px;
  bottom:-10px;
  z-index:-1;
  border-radius:24px;
  background:
    radial-gradient(
      circle at 20% 20%,
      rgba(101,86,245,.08),
      transparent 48%
    );
}

/* tabs sit cleanly over the new background */
.tabs{
  border-bottom-color:rgba(202,211,226,.8);
}

/* keep diagram laboratory surfaces strong */
.diagram-stage{
  background:
    radial-gradient(circle at 50% 35%,rgba(255,255,255,.72),transparent 52%),
    linear-gradient(180deg,#f5f8fd,#e9eff7);
}

/* Practice / Exam banners remain contrast-heavy */
.practice-banner,
.ai-banner{
  box-shadow:
    0 14px 34px rgba(16,26,46,.12);
}

/* inputs */
.controls input,
.search,
.chatbar input,
.filters select{
  box-shadow:inset 0 1px 2px rgba(30,45,75,.035);
}

/* subtle hover lift for cards */
.panel,
.qcard{
  transition:
    transform .18s ease,
    box-shadow .18s ease,
    border-color .18s ease;
