/* PHYSICS WHITEBOARD SYSTEM v1 */

.whiteboard-tab{
  position:fixed;
  left:0;
  top:50%;
  transform:translateY(-50%);
  z-index:1200;

  width:42px;
  min-height:146px;

  border:1px solid rgba(103,232,249,.30);
  border-left:0;
