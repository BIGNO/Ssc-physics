  color:#67e8f9;
  box-shadow:
    0 12px 30px rgba(0,0,0,.28),
    inset 0 1px 0 rgba(255,255,255,.06);

  display:flex;
  flex-direction:column;
  align-items:center;
  justify-content:center;
  gap:10px;

  cursor:pointer;
  transition:
    left .30s ease,
    background .20s ease,
    box-shadow .20s ease;
}

.whiteboard-tab:hover{
  background:
    linear-gradient(
      180deg,
      rgba(14,44,70,.99),
