  left:360px;
  border-radius:0 12px 12px 0;
}

.whiteboard-tab-icon{
  font-size:19px;
  line-height:1;
}

.whiteboard-tab > span:last-child{
  writing-mode:vertical-rl;
  transform:rotate(180deg);
  font-size:8px;
  font-weight:900;
  letter-spacing:.14em;
}

