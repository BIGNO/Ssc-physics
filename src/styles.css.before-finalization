  50%{transform:translate(52px,52px)}
}

@keyframes stdPressure{
  0%,100%{transform:scale(1)}
  50%{transform:scale(1.35)}
}

@keyframes stdPressureArrow{
  0%,100%{opacity:.45}
  50%{opacity:1}
}

@keyframes stdParticle{
  0%,100%{transform:translate(0,0)}
  25%{transform:translate(6px,-5px)}
  50%{transform:translate(-5px,7px)}
  75%{transform:translate(4px,5px)}
}

@keyframes stdHeatFlow{
  from{stroke-dashoffset:0}
  to{stroke-dashoffset:-90}
}

@keyframes stdHot{
  0%,100%{transform:translateY(0)}
  50%{transform:translateY(-8px)}
}

@keyframes stdCold{
  0%,100%{transform:translateY(0)}
  50%{transform:translateY(5px)}
}

@keyframes stdThermal{
  0%,100%{transform:translate(0,0)}
  50%{transform:translate(6px,-7px)}
}

@keyframes stdExpand{
  0%,100%{transform:scaleX(1)}
  50%{transform:scaleX(1.10)}
}

@keyframes stdWave{
  from{stroke-dashoffset:0}
  to{stroke-dashoffset:-100}
}

@keyframes stdSoundCompress{
  0%,100%{transform:translateX(0)}
  50%{transform:translateX(14px)}
}

@keyframes stdEchoOut{
  0%,100%{stroke-dashoffset:0;opacity:.35}
  45%{stroke-dashoffset:-30;opacity:1}
}

@keyframes stdEchoBack{
  0%,55%{stroke-dashoffset:30;opacity:.25}
  100%{stroke-dashoffset:-30;opacity:1}
}

@keyframes stdRayIn{
  0%,100%{opacity:.45}
  50%{opacity:1}
}

@keyframes stdRayOut{
  0%,100%{opacity:.45}
  60%{opacity:1}
}

@keyframes stdRefractionIn{
  0%,100%{opacity:.5}
  50%{opacity:1}
}

@keyframes stdRefractionOut{
  0%,100%{opacity:.35}
  60%{opacity:1}
}

@keyframes stdLensRay{
  0%,100%{opacity:.45}
  55%{opacity:1}
}

@keyframes stdFocus{
  0%,100%{transform:scale(1);opacity:.5}
  50%{transform:scale(1.35);opacity:1}
}

@keyframes stdChargeFlow{
  from{stroke-dashoffset:0}
  to{stroke-dashoffset:-70}
}

@keyframes stdFieldFlow{
  from{stroke-dashoffset:0}
  to{stroke-dashoffset:-65}
}

@keyframes stdElectron{
  from{transform:translateX(0)}
  to{transform:translateX(-105px)}
}

@keyframes stdGraphPulse{
  0%,100%{stroke-width:2.5}
  50%{stroke-width:4}
}

@keyframes stdCoilRotate{
  from{stroke-dashoffset:0}
  to{stroke-dashoffset:-60}
}

@keyframes stdRotor{
  from{transform:rotate(0deg)}
  to{transform:rotate(360deg)}
}

@keyframes stdMotorTorque{
  0%,100%{opacity:.35}
  50%{opacity:1}
}

@keyframes stdRadiation{
  from{stroke-dashoffset:0}
  to{stroke-dashoffset:-70}
}

@keyframes stdDecayTrace{
  0%,100%{stroke-width:3}
  50%{stroke-width:4}
}

@keyframes stdHalfPulse{
  0%,100%{opacity:.40}
  50%{opacity:1}
}

@keyframes stdAC{
  from{stroke-dashoffset:0}
  to{stroke-dashoffset:-80}
}

@keyframes stdDC{
  0%,100%{opacity:.55}
  50%{opacity:1}
}

