.physics-reference-board{
  width:100%;
  background:#060708;
  color:#f4f7fb;
  border:1px solid rgba(255,255,255,.07);
  border-radius:24px;
  overflow:hidden;
  box-shadow:0 22px 70px rgba(0,0,0,.2);
}

.prb-header{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:18px;
  padding:24px 28px 16px;
}

.prb-brand{
  font-size:10px;
  font-weight:900;
  letter-spacing:2.6px;
  color:#89aee0;
}

.prb-header h2{
